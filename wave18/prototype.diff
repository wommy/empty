+	// the space and mount rows of wave18 (simfacts-spec.md)
+	{row: "SPC-01", what: "a reservation leaves its dataset's available unchanged; a child's refreservation inside it is charged once; a refreservation is its own dataset's available",
+		check: func(f *factEnv) error {
