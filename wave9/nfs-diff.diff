+}
+
+// ---- exports.c: parseopts ------------------------------------------------------
+
+// addFlavor is secinfo_addflavor (exports.c:468-485): the index of the
+// flavor (by number), appended with the current e_flags if new.
+func addFlavor(f *flavor, ep *Entry) int {
+	for i, s := range ep.Secinfo {
+		if s.Flavor == f.name || s.Num == f.num {
+			return i
+		}
+	}
+	if len(ep.Secinfo) >= secflavorCount {
+		return -1
+	}
+	ep.Secinfo = append(ep.Secinfo, SecEntry{Flavor: f.name, Num: f.num, Flags: ep.Flags})
+	return len(ep.Secinfo) - 1
+}
+
+func setflags(mask int, active uint, ep *Entry) { // exports.c:590-602
+	ep.Flags |= mask
+	for bit := 0; active != 0; bit, active = bit+1, active>>1 {
+		if active&1 != 0 {
+			ep.Secinfo[bit].Flags |= mask
+		}
+	}
+}
+
+func clearflags(mask int, active uint, ep *Entry) { // exports.c:605-617
+	ep.Flags &^= mask
+	for bit := 0; active != 0; bit, active = bit+1, active>>1 {
+		if active&1 != 0 {
+			ep.Secinfo[bit].Flags &^= mask
+		}
+	}
+}
+
+// cStrtol is strtol/strtoul's parse (leading space, sign, base 0 or 10):
+// the value and the unparsed rest.
+func cStrtol(s string, base int) (int64, string) {
+	i := 0
+	for i < len(s) && isspaceC(int(s[i])) {
+		i++
+	}
+	neg := false
+	if i < len(s) && (s[i] == '+' || s[i] == '-') {
+		neg = s[i] == '-'
+		i++
+	}
+	if base == 0 {
+		switch {
+		case i+1 < len(s) && s[i] == '0' && (s[i+1] == 'x' || s[i+1] == 'X') && i+2 < len(s) && isHex(s[i+2]):
+			base, i = 16, i+2
+		case i < len(s) && s[i] == '0':
+			base = 8
+		default:
+			base = 10
+		}
+	}
+	start := i
+	var v int64
+	for i < len(s) {
+		d := digitVal(s[i])
+		if d < 0 || d >= base {
+			break
+		}
+		if v < 1<<60 {
+			v = v*int64(base) + int64(d)
+		}
+		i++
+	}
+	if i == start {
+		return 0, s // no digits: endptr = nptr
+	}
+	if neg {
+		v = -v
+	}
+	return v, s[i:]
+}
+
+func isHex(c byte) bool { return digitVal(c) >= 0 && digitVal(c) < 16 }
+
+func digitVal(c byte) int {
+	switch {
+	case c >= '0' && c <= '9':
+		return int(c - '0')
+	case c >= 'a' && c <= 'z':
+		return int(c-'a') + 10
+	case c >= 'A' && c <= 'Z':
+		return int(c-'A') + 10
+	}
+	return -1
+}
+
+func isblankC(c byte) bool { return c == ' ' || c == '\t' }
+
+// parseopts (exports.c:637-864). It returns false on a bad option, which
+// makes getexportent fail.
+func (p *parser) parseopts(cp string, ep *Entry, _ bool) bool {
+	var active uint
+	sawReexport := false
+	i := 0
+	for i < len(cp) && isblankC(cp[i]) {
+		i++
+	}
+	for i < len(cp) {
+		j := strings.IndexByte(cp[i:], ',')
+		var opt string
+		if j < 0 {
+			opt, i = cp[i:], len(cp)
+		} else {
+			opt, i = cp[i:i+j], i+j+1
+		}
+		switch {
+		case opt == "ro":
+			setflags(ExpReadonly, active, ep)
+		case opt == "rw":
+			clearflags(ExpReadonly, active, ep)
+		case opt == "secure":
+			clearflags(ExpInsecurePort, active, ep)
+		case opt == "insecure":
+			setflags(ExpInsecurePort, active, ep)
+		case opt == "sync":
+			clearflags(ExpAsync, active, ep)
+		case opt == "async":
+			setflags(ExpAsync, active, ep)
+		case opt == "nordirplus":
+			setflags(ExpNoReaddirPlus, active, ep)
+		case opt == "security_label":
+			setflags(ExpSecurityLabel, active, ep)
+		case opt == "sign_fh":
+			setflags(ExpSignFH, active, ep)
+		case opt == "nohide":
+			setflags(ExpNoHide, active, ep)
+		case opt == "hide":
+			clearflags(ExpNoHide, active, ep)
+		case opt == "crossmnt":
+			setflags(ExpCrossMount, active, ep)
+		case opt == "nocrossmnt":
+			clearflags(ExpCrossMount, active, ep)
+		case opt == "wdelay":
+			setflags(ExpGatheredWrites, active, ep)
+		case opt == "no_wdelay":
+			clearflags(ExpGatheredWrites, active, ep)
+		case opt == "root_squash":
+			setflags(ExpRootSquash, active, ep)
+		case opt == "no_root_squash":
+			clearflags(ExpRootSquash, active, ep)
+		case opt == "all_squash":
+			setflags(ExpAllSquash, active, ep)
+		case opt == "no_all_squash":
+			clearflags(ExpAllSquash, active, ep)
+		case opt == "subtree_check":
+			clearflags(ExpNoSubtreeCheck, active, ep)
+		case opt == "no_subtree_check":
+			setflags(ExpNoSubtreeCheck, active, ep)
+		case opt == "auth_nlm", opt == "secure_locks":
+			clearflags(ExpNoAuthNLM, active, ep)
+		case opt == "no_auth_nlm", opt == "insecure_locks":
+			setflags(ExpNoAuthNLM, active, ep)
+		case opt == "acl":
+			clearflags(ExpNoACL, active, ep)
+		case opt == "no_acl":
+			setflags(ExpNoACL, active, ep)
+		case opt == "pnfs":
+			setflags(ExpPNFS, active, ep)
+		case opt == "no_pnfs":
+			clearflags(ExpPNFS, active, ep)
+		case strings.HasPrefix(opt, "anonuid="), strings.HasPrefix(opt, "anongid="): // :725-742
+			v, rest := cStrtol(opt[8:], 10)
+			if opt[8:] == "" || rest != "" {
+				p.logf("%s: bad %s %q", p.fname, opt[:7], opt)
+				return false
+			}
+			if opt[4] == 'u' {
+				ep.AnonUID = int64(uint32(v))
+			} else {
+				ep.AnonGID = int64(uint32(v))
+			}
+		case strings.HasPrefix(opt, "squash_uids="), strings.HasPrefix(opt, "squash_gids="): // :743-750
+			// parsesquash sees opt, already cut at the next ',', so a
+			// list stops at its first id range (exports.c:655-662, 874-904)
+			ids, ok := parsesquash(opt[12:])
+			if !ok {
+				p.logf("syntax error: bad uid/gid list")
+				return false
+			}
+			if opt[7] == 'u' {
+				ep.Squids = append(ep.Squids, ids...)
+			} else {
+				ep.Sqgids = append(ep.Sqgids, ids...)
+			}
+		case strings.HasPrefix(opt, "fsid="): // :751-774
+			if sawReexport {
+				p.logf("'fsid=' has to be before 'reexport=' %s", opt)
+				return false
+			}
+			if opt[5:] == "root" {
+				ep.FsidNum = 0
+				setflags(ExpFSID, active, ep)
+			} else {
+				v, rest := cStrtol(opt[5:], 0)
+				switch {
+				case opt[5:] != "" && rest == "":
+					ep.FsidNum = uint64(v)
+					setflags(ExpFSID, active, ep)
+				case validUUID(opt[5:]):
+					ep.UUID = opt[5:]
+				default:
+					p.logf("bad fsid %q", opt)
+					return false
+				}
+			}
+		case opt == "mountpoint", opt == "mp", strings.HasPrefix(opt, "mountpoint="), strings.HasPrefix(opt, "mp="): // :775-783
+			m := ""
+			if k := strings.IndexByte(opt, '='); k >= 0 {
+				m = opt[k+1:]
+			}
+			ep.Mountpt = &m
+		case strings.HasPrefix(opt, "refer="): // :794-796
+			ep.FslocKind, ep.FslocData = "refer", opt[6:]
+		case strings.HasPrefix(opt, "replicas="): // :797-799
+			ep.FslocKind, ep.FslocData = "replicas", opt[9:]
+		case strings.HasPrefix(opt, "sec="): // :800-803, parse_flavors :500-518
+			active = 0
+			for _, name := range strings.Split(opt[4:], ":") {
+				f := findFlavor(name)
+				if f == nil {
+					p.logf("unknown flavor %s", name)
+					return false
+				}
+				bit := addFlavor(f, ep)
+				if bit < 0 {
+					return false
+				}
+				active |= 1 << bit
+			}
+		case strings.HasPrefix(opt, "xprtsec="): // :804-806
+			for _, name := range strings.Split(opt[8:], ":") {
+				if name != "none" && name != "tls" && name != "mtls" {
+					p.logf("unknown xprtsec mode %s", name)
+					return false
+				}
+				dup := false
+				for _, x := range ep.Xprtsec {
+					dup = dup || x == name
+				}
+				if !dup {
+					ep.Xprtsec = append(ep.Xprtsec, name)
+				}
+			}
+		case strings.HasPrefix(opt, "reexport="): // :807-841
+			s := opt[9:]
+			if sawReexport || (s != "auto-fsidnum" && s != "predefined-fsidnum" && s != "none") {
+				p.logf("bad option %s", opt)
+				return false
+			}
+			// reexpdb_apply_reexport_settings needs the reexport
+			// database (ambiguity: not modelled; fsid left as is)
+			ep.Reexport = s
+			sawReexport = true
+		default: // :842-847
+			p.logf("unknown keyword %q", opt)
+			setflags(ExpAllSquash|ExpReadonly, active, ep)
+			return false
+		}
+		for i < len(cp) && isblankC(cp[i]) {
+			i++
+		}
+	}
+	fixPseudoflavorFlags(ep)
+	return true
+}
+
+// fixPseudoflavorFlags (exports.c:624-632).
+func fixPseudoflavorFlags(ep *Entry) {
+	for k := range ep.Secinfo {
+		ep.Secinfo[k].Flags |= ep.Flags &^ SecinfoFlags
+	}
+}
+
+// parsesquash (exports.c:866-909) on one option's value: ids are N or
+// N-M separated by ','; it stops at the end or at ')'.
+func parsesquash(s string) ([]int, bool) {
+	var ids []int
+	i := 0
+	num := func() int { // parsenum :926-938: atoi of [-]digits
+		start := i
+		if i < len(s) && s[i] == '-' {
+			i++
+		}
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			i++
+		}
+		v, _ := strconv.Atoi(s[start:i])
+		return v
+	}
+	for {
+		id0 := num()
+		id1 := id0
+		if i < len(s) && s[i] == '-' {
+			i++
+			id1 = num()
+		}
+		if id0 == -1 || id1 == -1 {
+			return nil, false
+		}
+		ids = append(ids, id0, id1)
+		if i >= len(s) || s[i] == ')' || (s[i] == ',' && !(i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '9')) {
+			break
+		}
+		if s[i] != ',' {
+			return nil, false
+		}
+		i++
+	}
+	return ids, true
+}
+
+func validUUID(s string) bool { // exports.c:453-461
+	n := 0
+	for i := 0; i < len(s); i++ {
+		if isHex(s[i]) {
+			n++
+		}
+	}
+	return n == 32
+}
+
+// ---- exports.c: putexportent -----------------------------------------------------
+
+// fprintpath (exports.c:266-275): control characters, '"', '\\', '#' and
+// whitespace as \ooo.
+func fprintpath(b *strings.Builder, path string) {
+	for i := 0; i < len(path); i++ {
+		c := path[i]
+		if c < 0x20 || c == 0x7f || c == '"' || c == '\\' || c == '#' || isspaceC(int(c)) {
+			fmt.Fprintf(b, "\\%03o", c)
+		} else {
+			b.WriteByte(c)
+		}
+	}
+}
+
+// ensureSecinfo is secinfo_show's side effect (exports.c:243-244): an
+// entry without a flavor gets "sys" with the entry's flags.
+func ensureSecinfo(ep *Entry) {
+	if len(ep.Secinfo) == 0 {
+		addFlavor(findFlavor("sys"), ep)
+	}
+}
+
+// PutExportent renders one etab line (putexportent, exports.c:277-383,
+// secinfo_show :236-253, xprtsecinfo_show :255-264).
+func PutExportent(ep Entry) string {
+	ensureSecinfo(&ep)
+	var b strings.Builder
+	fprintpath(&b, ep.Path)
+	f := ep.Flags
+	yn := func(cond bool, y, n string) string {
+		if cond {
+			return y
+		}
+		return n
+	}
+	fmt.Fprintf(&b, "\t%s(", ep.Hostname)
+	b.WriteString(yn(f&ExpReadonly != 0, "ro,", "rw,"))
+	b.WriteString(yn(f&ExpAsync != 0, "async,", "sync,"))
+	b.WriteString(yn(f&ExpGatheredWrites != 0, "wdelay,", "no_wdelay,"))
+	b.WriteString(yn(f&ExpNoHide != 0, "nohide,", "hide,"))
+	b.WriteString(yn(f&ExpCrossMount != 0, "crossmnt,", "nocrossmnt,"))
+	b.WriteString(yn(f&ExpInsecurePort != 0, "insecure,", "secure,"))
+	b.WriteString(yn(f&ExpRootSquash != 0, "root_squash,", "no_root_squash,"))
+	b.WriteString(yn(f&ExpAllSquash != 0, "all_squash,", "no_all_squash,"))
+	b.WriteString(yn(f&ExpNoSubtreeCheck != 0, "no_subtree_check,", "subtree_check,"))
+	b.WriteString(yn(f&ExpNoAuthNLM != 0, "insecure_locks,", "secure_locks,"))
+	b.WriteString(yn(f&ExpNoACL != 0, "no_acl,", "acl,"))
+	if f&ExpNoReaddirPlus != 0 {
+		b.WriteString("nordirplus,")
+	}
+	if f&ExpSecurityLabel != 0 {
+		b.WriteString("security_label,")
+	}
+	if f&ExpSignFH != 0 {
+		b.WriteString("sign_fh,")
+	}
+	b.WriteString(yn(f&ExpPNFS != 0, "pnfs,", "no_pnfs,"))
+	if f&ExpFSID != 0 {
+		fmt.Fprintf(&b, "fsid=%d,", int32(ep.FsidNum))
+	}
+	if ep.UUID != "" {
+		fmt.Fprintf(&b, "fsid=%s,", ep.UUID)
+	}
+	if ep.Reexport != "" && ep.Reexport != "none" {
+		fmt.Fprintf(&b, "reexport=%s,", ep.Reexport)
+	}
+	if ep.Mountpt != nil {
+		b.WriteString("mountpoint")
+		if *ep.Mountpt != "" {
+			b.WriteString("=" + *ep.Mountpt)
+		}
+		b.WriteString(",")
+	}
+	if ep.FslocKind != "" {
+		b.WriteString(ep.FslocKind + "=")
+		fprintpath(&b, ep.FslocData)
+		b.WriteString(",")
+	}
+	if ep.Squids != nil {
+		b.WriteString("squash_uids=")
+		writeIDs(&b, ep.Squids, len(ep.Squids))
+	}
+	if ep.Sqgids != nil {
+		b.WriteString("squash_gids=")
+		writeIDs(&b, ep.Sqgids, len(ep.Squids)) // sic: e_nsquids (exports.c:373)
+	}
+	fmt.Fprintf(&b, "anonuid=%d,anongid=%d", int32(ep.AnonUID), int32(ep.AnonGID))
+	for k := 0; k < len(ep.Secinfo); {
+		s := ep.Secinfo[k]
+		b.WriteString(",sec=" + s.Flavor)
+		k++
+		for k < len(ep.Secinfo) && ep.Secinfo[k].Flags == s.Flags {
+			b.WriteString(":" + ep.Secinfo[k].Flavor)
+			k++
+		}
+		for _, m := range []struct {
+			flag     int
+			set, uns string
+		}{{ExpReadonly, "ro", "rw"}, {ExpInsecurePort, "insecure", "secure"}, {ExpRootSquash, "root_squash", "no_root_squash"}, {ExpAllSquash, "all_squash", "no_all_squash"}} {
+			if SecinfoFlags&m.flag != 0 {
+				b.WriteString("," + yn(s.Flags&m.flag != 0, m.set, m.uns))
+			}
+		}
+	}
+	if len(ep.Xprtsec) > 0 {
+		b.WriteString(",xprtsec=" + strings.Join(ep.Xprtsec, ":"))
+	}
+	b.WriteString(")\n")
+	return b.String()
+}
+
+func writeIDs(b *strings.Builder, id []int, n int) {
+	for k := 0; k+1 < n && k+1 < len(id); k += 2 {
+		if id[k] != id[k+1] {
+			fmt.Fprintf(b, "%d-%d,", id[k], id[k+1])
+		} else {
+			fmt.Fprintf(b, "%d,", id[k])
+		}
+	}
+}
diff --git a/internal/nfsref/grammar_test.go b/internal/nfsref/grammar_test.go
new file mode 100644
index 0000000..9ec46eb
--- /dev/null
+++ b/internal/nfsref/grammar_test.go
@@ -0,0 +1,51 @@
+package nfsref
+
+import (
+	"net/netip"
+	"testing"
+)
+
+// TestClientGrammarBareVsCIDR pins what nfs-utils does with a bare address
+// versus a /32 (checked against a real exportfs 3.1.1 build): a bare
+// address is an FQDN client that is looked up, merged with any name client
+// resolving to the same address (first spelling wins in etab, the second
+// entry is IGNORED) and beats every subnet line at mountd regardless of
+// file order; a /32 is a subnet client kept verbatim and never merged.
+func TestClientGrammarBareVsCIDR(t *testing.T) {
+	res := func(name string) (string, []netip.Addr, bool) {
+		if name == "node-a" {
+			return "node-a", []netip.Addr{netip.MustParseAddr("10.0.0.5")}, true
+		}
+		return NumericResolver(name)
+	}
+	ip := netip.MustParseAddr("10.0.0.5")
+	for _, tc := range []struct {
+		exports string
+		etab    []string // hosts of /a, etab order
+		mode    Mode
+	}{
+		{"/a 10.0.0.5(rw)\n", []string{"10.0.0.5 rw"}, RW},
+		{"/a 10.0.0.5/32(rw)\n", []string{"10.0.0.5/32 rw"}, RW},
+		// both kept: different client classes; the bare one wins at mountd
+		{"/a 10.0.0.5/32(ro) 10.0.0.5(rw)\n", []string{"10.0.0.5 rw", "10.0.0.5/32 ro"}, RW},
+		// a foreign name line swallows the bare address and renames it
+		{"/a node-a(ro)\n/a 10.0.0.5(rw)\n", []string{"node-a ro"}, RO},
+		// ... but never the /32; the name line still wins (FQDN class first)
+		{"/a node-a(ro)\n/a 10.0.0.5/32(rw)\n", []string{"node-a ro", "10.0.0.5/32 rw"}, RO},
+	} {
+		_, tab := ExportfsRA(ExportsFiles{Exports: []byte(tc.exports)}, res, nil)
+		got := tab.HostsOf("/a")
+		if len(got) != len(tc.etab) {
+			t.Errorf("%q: etab %q, want %q", tc.exports, got, tc.etab)
+			continue
+		}
+		for i := range got {
+			if got[i] != tc.etab[i] {
+				t.Errorf("%q: etab %q, want %q", tc.exports, got, tc.etab)
+			}
+		}
+		if m := tab.Access("/a", ip, Env{}).Mode; m != tc.mode {
+			t.Errorf("%q: 10.0.0.5 gets %v, want %v", tc.exports, m, tc.mode)
+		}
+	}
+}
diff --git a/internal/nfsref/libshare.go b/internal/nfsref/libshare.go
new file mode 100644
index 0000000..2bf892d
--- /dev/null
+++ b/internal/nfsref/libshare.go
@@ -0,0 +1,304 @@
+// Package nfsref is a reference model of the Linux NFS export chain the
+// endpoint drives: OpenZFS libshare (sharenfs -> /etc/exports.d/zfs.exports),
+// nfs-utils exportfs (exports files -> /var/lib/nfs/etab) and mountd's
+// export lookup (etab -> what a client address is granted). Every function
+// is derived line by line from the C sources; citations name the file and
+// lines at these revisions:
+//
+//   - openzfs a128b8a (2.4 line): lib/libzfs/os/linux/libzfs_share_nfs.c
+//     ("share_nfs.c"), lib/libzfs/libzfs_share_nfs.c ("libshare_nfs.c"),
+//     lib/libzfs/libzfs_share.c, lib/libzfs/libzfs_dataset.c;
+//   - nfs-utils 3.1.1 (5090e0b): support/nfs/exports.c, support/nfs/xio.c,
+//     support/export/{export,client,xtab,hostname,cache,auth}.c,
+//     utils/exportfs/exportfs.c.
+//
+// What the model cannot know is injected: name resolution (Resolver),
+// realpath(3) and mountpoint checks. Behaviour that depends on libc or the
+// kernel rather than on these sources is marked "ambiguity" and is what the
+// real-nfsd replay (internal/endpoint nfs_replay_test.go) checks.
+package nfsref
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// ErrSyntax is libshare's SA_SYNTAX_ERR: `zfs set sharenfs=...` fails with
+// "'sharenfs' cannot be set to invalid options".
+var ErrSyntax = errors.New("SA_SYNTAX_ERR")
+
+// ExportsHeader starts every zfs.exports file libzfs writes
+// (libzfs_share.h:103 NFS_FILE_HEADER; libshare_nfs.c:233).
+const ExportsHeader = "# !!! DO NOT EDIT THIS FILE MANUALLY !!!\n\n"
+
+// ValidateSharenfs is the check `zfs set`/`zfs create -o` applies to a
+// sharenfs value (libzfs_dataset.c:1229-1248): "on" and "off" pass; any
+// other value goes through sa_validate_shareopts (libzfs_share.c:103-112),
+// which refuses \a \b \f \n \r anywhere, then nfs_validate_shareopts
+// (share_nfs.c:498-512): "" is refused, else the value must convert with
+// get_linux_shareopts. Tab, \v and space are NOT refused.
+func ValidateSharenfs(v string) error {
+	if v == "on" || v == "off" {
+		return nil
+	}
+	if strings.ContainsAny(v, "\a\b\f\n\r") {
+		return ErrSyntax
+	}
+	if v == "" {
+		return ErrSyntax
+	}
+	_, err := linuxShareopts(v)
+	return err
+}
+
+// foreachShareopt is foreach_nfs_shareopt (share_nfs.c:51-109): "on" is
+// "rw,crossmnt" (:61-62); options split on ','; empty options are skipped
+// (:84 cur > opt); the key ends at the first '=' (:85-90), value nil when
+// there is none.
+func foreachShareopt(shareopts string, cb func(key string, value *string) error) error {
+	if shareopts == "on" {
+		shareopts = "rw,crossmnt"
+	}
+	for _, opt := range strings.Split(shareopts, ",") {
+		if opt == "" {
+			continue
+		}
+		var value *string
+		if i := strings.IndexByte(opt, '='); i >= 0 {
+			v := opt[i+1:]
+			value, opt = &v, opt[:i]
+		}
+		if err := cb(opt, value); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// splitHosts walks a rw=/ro= host list like foreach_nfs_host_cb
+// (share_nfs.c:151-207): hosts are separated by ':'; a host starting with
+// '[' is an IPv6 literal, optionally followed by "/len". An empty list
+// value is one empty host (no "*" substitution here: only a missing value,
+// nil, becomes "*", :141-142).
+func splitHosts(value string) ([]string, error) {
+	var hosts []string
+	host := value
+	for {
+		var next string
+		more := false
+		if strings.HasPrefix(host, "[") {
+			host = host[1:]                     // :155
+			end := strings.IndexByte(host, ']') // :156
+			if end < 0 {
+				return nil, ErrSyntax // :157-160
+			}
+			rest := host[end+1:]
+			switch {
+			case rest == "": // :161-163
+				host = host[:end]
+			case rest[0] == '/': // :164-180: drop ']' and keep "/len"
+				if c := strings.IndexByte(rest[1:], ':'); c >= 0 {
+					next, more = rest[1+c+1:], true
+					host = host[:end] + rest[:1+c]
+				} else {
+					host = host[:end] + rest
+				}
+			case rest[0] == ':': // :181-183
+				next, more = rest[1:], true
+				host = host[:end]
+			default:
+				return nil, ErrSyntax // :184-187
+			}
+		} else if c := strings.IndexByte(host, ':'); c >= 0 { // :189-193
+			next, more = host[c+1:], true
+			host = host[:c]
+		}
+		hosts = append(hosts, host)
+		if !more {
+			return hosts, nil
+		}
+		host = next
+	}
+}
+
+// validKeys is get_linux_shareopts_cb's sorted list (share_nfs.c:303-309).
+var validKeys = []string{"all_squash", "anongid",
+	"anonuid", "async", "auth_nlm", "crossmnt", "fsid", "fsuid", "hide",
+	"insecure", "insecure_locks", "mountpoint", "mp", "no_acl",
+	"no_all_squash", "no_auth_nlm", "no_root_squash",
+	"no_subtree_check", "no_wdelay", "nohide", "refer", "replicas",
+	"root_squash", "secure", "secure_locks", "subtree_check", "sync",
+	"wdelay"}
+
+// linuxShareopts is get_linux_shareopts (share_nfs.c:379-403) with its
+// callback get_linux_shareopts_cb (:299-373): the option string appended
+// to every host's access mode.
+func linuxShareopts(shareopts string) (string, error) {
+	opts := []string{"no_subtree_check", "mountpoint"} // :389, :392
+	add := func(key string, value *string) {           // add_linux_shareopt :258-288
+		if value != nil {
+			opts = append(opts, key+"="+*value)
+		} else {
+			opts = append(opts, key)
+		}
+	}
+	err := foreachShareopt(shareopts, func(key string, value *string) error {
+		if key == "sec" { // :314-315
+			return nil
+		}
+		if key == "ro" || key == "rw" { // :317-353: only the [v6] syntax is checked
+			if value == nil || *value == "" {
+				return nil
+			}
+			_, err := splitHosts(*value)
+			return err
+		}
+		if key == "anon" { // :355-356
+			key = "anonuid"
+		}
+		if key == "root_mapping" { // :358-361
+			add("root_squash", nil)
+			key = "anonuid"
+		}
+		if key == "nosub" { // :363-364
+			key = "subtree_check"
+		}
+		if _, ok := slices.BinarySearch(validKeys, key); !ok { // :366-368
+			return ErrSyntax
+		}
+		add(key, value)
+		return nil
+	})
+	if err != nil {
+		return "", err
+	}
+	return strings.Join(opts, ","), nil
+}
+
+// linuxHostspec is get_linux_hostspec (share_nfs.c:237-253): a leading '@'
+// is dropped, so "@10.0.0.0/8" is the subnet, never a netgroup.
+func linuxHostspec(h string) string {
+	return strings.TrimPrefix(h, "@")
+}
+
+// EscapeMountpoint is nfs_escape_mountpoint (libshare_nfs.c:142-168):
+// \t \n \v \f \r space and backslash become \ooo. '"' and '#' are not
+// escaped.
+func EscapeMountpoint(mp string) string {
+	if !strings.ContainsAny(mp, "\t\n\v\f\r \\") {
+		return mp
+	}
+	var b strings.Builder
+	for i := 0; i < len(mp); i++ {
+		if strings.IndexByte("\t\n\v\f\r \\", mp[i]) >= 0 {
+			fmt.Fprintf(&b, "\\%03o", mp[i])
+		} else {
+			b.WriteByte(mp[i])
+		}
+	}
+	return b.String()
+}
+
+// ExportsLines is what nfs_enable_share_impl (share_nfs.c:440-452) writes
+// for one dataset: get_linux_shareopts first (an error writes nothing),
+// then one nfs_add_entry line per host (:410-435):
+//
+//	<escaped mp> <host without '@'>(sec=<sec>,<rw|ro>,<linux opts>)\n
+//
+// sec starts as "sys" (:228) and each "sec" option changes it for the
+// hosts after it (:137-138); a bare "sec" makes it NULL, which glibc's
+// printf prints as "(null)" (ambiguity: libc). A missing rw/ro value is
+// "*" (:141-142); an empty one is an empty host, written as
+// "<mp> (sec=...)", which nfs-utils reads as "*" (exports.c:173-176).
+func ExportsLines(mountpoint, sharenfs string) ([]string, error) {
+	linuxOpts, err := linuxShareopts(sharenfs)
+	if err != nil {
+		return nil, err
+	}
+	mp := EscapeMountpoint(mountpoint)
+	security := "sys"
+	var lines []string
+	err = foreachShareopt(sharenfs, func(key string, value *string) error {
+		if key == "sec" {
+			if value == nil {
+				security = "(null)"
+			} else {
+				security = *value
+			}
+		}
+		if key != "rw" && key != "ro" {
+			return nil
+		}
+		v := "*"
+		if value != nil {
+			v = *value
+		}
+		hosts, err := splitHosts(v)
+		if err != nil {
+			return err
+		}
+		for _, h := range hosts {
+			lines = append(lines, fmt.Sprintf("%s %s(sec=%s,%s,%s)\n", mp, linuxHostspec(h), security, key, linuxOpts))
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return lines, nil
+}
+
+// ShareFile is nfs_toggle_share (libshare_nfs.c:244-277) on a zfs.exports
+// file: the header, every old line except comment and blank lines and
+// except those of mountpoint (nfs_copy_entries, :170-242: a line belongs
+// to mountpoint when its first field, up to a tab, space or newline, is
+// the escaped mountpoint), then the new lines. sharenfs "off" (unshare,
+// nfs_disable_share_impl :468-473) writes no new lines. On an error the
+// file is left as it was (:273-276) and the error is returned.
+func ShareFile(old, mountpoint, sharenfs string) (string, error) {
+	var lines []string
+	if sharenfs != "off" {
+		var err error
+		if err = ValidateSharenfs(sharenfs); err != nil { // sa_enable_share, libzfs_share.c:51-58
+			return old, err
+		}
+		if lines, err = ExportsLines(mountpoint, sharenfs); err != nil {
+			return old, err
+		}
+	}
+	mp := EscapeMountpoint(mountpoint)
+	var b strings.Builder
+	b.WriteString(ExportsHeader)
+	for _, line := range splitKeepNL(old) {
+		if line[0] == '\n' || line[0] == '#' { // :192-193
+			continue
+		}
+		sep := strings.IndexAny(line, "\t \n") // :196-198
+		if sep == len(mp) && strings.HasPrefix(line, mp) {
+			continue
+		}
+		b.WriteString(line)
+	}
+	for _, l := range lines {
+		b.WriteString(l)
+	}
+	return b.String(), nil
+}
+
+// splitKeepNL splits like getline(3): each piece keeps its '\n'; a last
+// piece without one is kept too.
+func splitKeepNL(s string) []string {
+	var out []string
+	for s != "" {
+		i := strings.IndexByte(s, '\n')
+		if i < 0 {
+			out = append(out, s)
+			break
+		}
+		out = append(out, s[:i+1])
+		s = s[i+1:]
+	}
+	return out
+}
