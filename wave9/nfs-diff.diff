+
+func atoiOr(s string, d int) int {
+	n := 0
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return d
+		}
+		n = n*10 + int(c-'0')
+	}
+	if s == "" {
+		return d
+	}
+	return n
+}
+
+var (
