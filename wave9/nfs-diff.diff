+		if !p.parseopts(exp[1:], &p.defEE, true) {
+			p.stoppedOnError = true
+			return nil
+		}
+		p.hasDefaultOpts = true
+		exp, ok = p.getexport()
+		if ok < 0 {
+			p.logf("expected client(options...)")
+			p.stoppedOnError = true
+			return nil
+		}
+	}
+	ee := p.defEE.clone() // :165
+	if ok == 0 {          // :168-169
+		exp = ""
+	}
