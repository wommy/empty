+// stream runs zfs and hands stdout to read; failures become *Error. An exit
+// status is classified from stderr; a read error is KindUnknown.
+func (c *Client) stream(ctx context.Context, op, dataset string, read func(io.Reader) error, args ...string) error {
+	var err error
+	if s, ok := c.Runner.(Streamer); ok {
+		err = s.Stream(ctx, c.bin(), args, read)
+	} else {
+		var out []byte
+		if out, err = c.Runner.Run(ctx, c.bin(), args...); err == nil {
+			err = read(bytes.NewReader(out))
+		}
+	}
+	if err == nil {
+		return nil
+	}
+	e := &Error{Op: op, Dataset: dataset, Err: err}
+	var ee *ExitError
+	if errors.As(err, &ee) {
+		e.Stderr = ee.Stderr
+		e.Kind = classify(ee.Stderr)
+	}
+	return e
+}
