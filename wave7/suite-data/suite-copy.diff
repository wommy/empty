 	"crypto/sha256"
 	"encoding/hex"
 	"fmt"
+	"sort"
 	"strconv"
 	"strings"
 	"unicode"
@@ -54,6 +55,43 @@ type Op struct {
 // Plan is the ordered ops of one request.
 type Plan []Op
 
+// String renders a plan one op per line with properties sorted, so the
+// same plan always prints the same text: golden files and logs compare it.
+//
+//	set tank/v/a volsize=2147483648 refreservation=auto
+func (p Plan) String() string {
+	var b strings.Builder
+	for _, op := range p {
+		b.WriteString(op.Kind.String())
+		b.WriteByte(' ')
+		b.WriteString(op.Target)
+		if op.Source != "" {
+			b.WriteString(" from=" + op.Source)
+		}
+		if op.Size != 0 {
+			b.WriteString(" size=" + u64(op.Size))
+		}
+		for _, f := range []struct {
+			on   bool
+			name string
+		}{{op.Sparse, "sparse"}, {op.Recursive, "recursive"}, {op.Defer, "defer"}, {op.OkExists, "ok-exists"}, {op.OkMissing, "ok-missing"}} {
+			if f.on {
+				b.WriteString(" +" + f.name)
+			}
+		}
+		keys := make([]string, 0, len(op.Props))
+		for k := range op.Props {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			b.WriteString(" " + k + "=" + strconv.Quote(op.Props[k])[1:len(strconv.Quote(op.Props[k]))-1])
+		}
+		b.WriteByte('\n')
+	}
+	return b.String()
+}
+
 // Planner holds what planning needs besides the table: pure configuration.
 type Planner struct {
 	Parent       string
