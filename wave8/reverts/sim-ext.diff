+// rename moves a dataset (with its descendants and snapshots) to a new
+// name in the same pool, like `zfs rename a b`: guids, properties and the
+// clone/origin graph follow it.
+func (s *Sim) rename(args []string) error {
+	if len(args) != 2 {
+		return exit("missing source dataset argument")
+	}
+	from, to := args[0], args[1]
+	n, ok := s.ds[from]
+	if !ok {
+		return exit("cannot open '%s': dataset does not exist", from)
+	}
+	if n.typ == zfs.TypeSnapshot || strings.Contains(to, "@") {
+		return exit("cannot rename to '%s': snapshot rename is not modelled", to)
+	}
+	if _, ok := s.ds[to]; ok {
+		return exit("cannot rename to '%s': dataset already exists", to)
+	}
+	if _, ok := s.ds[parent(to)]; !ok {
+		return exit("cannot rename to '%s': parent does not exist", to)
+	}
+	if strings.HasPrefix(to, from+"/") {
+		return exit("cannot rename to '%s': New name is a descendant of current name", to)
+	}
+	moved := map[string]string{from: to}
+	for _, k := range s.children(from) {
+		moved[k] = to + k[len(from):]
+	}
+	for old, nw := range moved {
+		s.ds[nw] = s.ds[old]
+		delete(s.ds, old)
+		if v, ok := s.live[old]; ok {
+			delete(s.live, old)
+			s.live[nw] = v
+		}
+	}
+	for _, d := range s.ds {
+		if nw, ok := moved[d.origin]; ok {
+			d.origin = nw
+		}
+	}
+	return nil
+}
+
+// hold runs `zfs hold tag snap`.
+func (s *Sim) hold(args []string) error {
+	if len(args) != 2 {
+		return exit("missing snapshot argument")
+	}
+	tag, name := args[0], args[1]
+	n, ok := s.ds[name]
+	if !ok || n.typ != zfs.TypeSnapshot {
+		return exit("cannot hold snapshot '%s': dataset does not exist", name)
+	}
+	if n.holds[tag] {
+		return exit("cannot hold snapshot '%s': tag already exists on this dataset", name)
+	}
+	if n.holds == nil {
+		n.holds = map[string]bool{}
+	}
+	n.holds[tag] = true
+	return nil
+}
+
+// release runs `zfs release tag snap`; releasing the last hold of a
+// snapshot marked for deferred destroy (and without clones) destroys it.
+func (s *Sim) release(args []string) error {
+	if len(args) != 2 {
+		return exit("missing snapshot argument")
+	}
+	tag, name := args[0], args[1]
+	n, ok := s.ds[name]
+	if !ok || n.typ != zfs.TypeSnapshot {
+		return exit("cannot release hold from snapshot '%s': dataset does not exist", name)
+	}
+	if !n.holds[tag] {
+		return exit("cannot release hold from snapshot '%s': no such tag on this dataset", name)
+	}
+	delete(n.holds, tag)
+	if len(n.holds) == 0 && n.defer_ && len(s.clonesOf(name)) == 0 {
+		s.remove(name)
+	}
+	return nil
+}
