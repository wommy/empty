+
+// Own is the endpoint's relation to a row. It replaces the managed and
+// provision_success booleans, whose combinations (committed but foreign,
+// managed but naming another volume, a managed snapshot without a CSI name)
+// every planner had to re-check, and did not all check alike.
+//
+// The zero value is Foreign: a Row literal, a phantom or anything decode
+// could not place is never acted on.
+type Own uint8
+
+const (
+	// Foreign: not ours. No local managed marker, or markers that name
+	// another volume or snapshot (a recv'd or renamed copy, ADR 0003).
+	Foreign Own = iota
+	// VolUncommitted: a volume we created whose provision never finished.
+	VolUncommitted
+	// VolCommitted: a provisioned volume.
+	VolCommitted
+	// SnapCSI: a CSI snapshot we cut.
+	SnapCSI
+	// SnapCloneSource: the internal "<vol>@volume-source-for-volume-<id>"
+	// snapshot a volume-to-volume clone hangs off. It carries no markers
+	// (the baseline cuts it bare), so it is ours by name only; reconcile
+	// also requires its volume to be ours.
+	SnapCloneSource
