+package endpoint
+
+// Reachability probes for wave5/impossible-types.md: each test drives a
+// representable-but-meaningless state through a real entry point and
+// records what happens today. They log rather than fail, so the same file
+// documents behaviour before and after the prototypes.
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/wommy/empty/internal/zfs"
+)
+
+// canned answers every zfs call with fixed `zfs get -Hp` output.
+type canned struct{ out string }
+
+func (c canned) Run(ctx context.Context, name string, args ...string) ([]byte, error) {
+	return []byte(c.out), nil
+}
+
+// getOutput prints every requested column for each dataset, "-" unless set.
+func getOutput(names props, rows map[string]map[string][2]string, order []string) string {
+	var b strings.Builder
+	for _, ds := range order {
+		for _, p := range names.columns() {
+			v, ok := rows[ds][p]
+			if !ok {
+				v = [2]string{"-", "-"}
+			}
+			fmt.Fprintf(&b, "%s\t%s\t%s\t%s\n", ds, p, v[0], v[1])
+		}
+	}
+	return b.String()
+}
+
+// A user property value with newlines can print lines for a dataset that
+// does not exist. The duplicate-line check (b540a2c) only catches forged
+// lines that collide with real ones; a phantom name collides with nothing.
+func TestReachPhantomRowListed(t *testing.T) {
+	n := props{"democratic-csi"}
+	real := getOutput(n, map[string]map[string][2]string{
+		"tank/v":   {"type": {"filesystem", "-"}},
+		"tank/v/a": {"type": {"filesystem", "-"}, n.managed(): {"true", "local"}, n.success(): {"true", "local"}, n.volumeName(): {"a", "local"}},
+	}, []string{"tank/v", "tank/v/a"})
+	// what a value "x\n<forged lines>" on tank/v/a prints as
+	forged := "tank/v/a@ghost\t" + n.managed() + "\ttrue\tlocal\n" +
+		"tank/v/a@ghost\t" + n.success() + "\ttrue\tlocal\n"
+	ep, err := New(zfs.New(canned{real + forged}), Config{Parent: "tank/v"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	vols, _, err := ep.ListVolumes(context.Background(), 0, "")
+	var ids []string
+	for _, v := range vols {
+		ids = append(ids, v.ID+"("+v.Kind.String()+")")
+	}
+	t.Logf("ListVolumes = %v, err = %v", ids, err)
+}
+
+// VolumeKind is an int: any value but Block/Filesystem skips every
+// kind-specific check in validateCreate and plans a filesystem.
+func TestReachVolumeKindOutOfRange(t *testing.T) {
+	plan, err := pl.PlanCreateVolume(NewTable(nil), CreateVolumeRequest{Name: "a", Kind: VolumeKind(7), Reserve: true, Sparse: true})
+	t.Logf("Kind=7 Reserve+Sparse, no capacity: plan=%+v err=%v", plan, err)
+}
+
+// A Planner literal without VolBlockSize divides by zero on a block create.
+func TestReachZeroPlannerPanics(t *testing.T) {
+	defer func() { t.Logf("recovered: %v", recover()) }()
+	plan, err := (Planner{Parent: "tank/v", Names: props{"p"}}).PlanCreateVolume(NewTable(nil), CreateVolumeRequest{Name: "a", Kind: Block, CapacityBytes: 1000})
+	t.Logf("plan=%v err=%v", plan, err)
+}
+
+// NFSClient has exported fields: the planner trusts whatever it is given.
+func TestReachUnparsedClient(t *testing.T) {
+	row := vol("a", func(r *Row) { r.Mounted, r.Mount, r.ShareNFS = true, "/tank/v/a", "off" })
+	plan, _, err := pl.PlanPublishExport(NewTable([]Row{row}), Etab{}, "a", NFSClient{Host: "*"})
+	t.Logf("plan=%v err=%v", plan, err)
+}
+
+// PropertyPrefix is not validated: New accepts a prefix zfs will refuse
+// (uppercase) or that splits the -o column list (comma).
+func TestReachPropertyPrefix(t *testing.T) {
+	for _, p := range []string{"Bad Prefix", "a,type", "x:"} {
+		ep, err := New(zfs.New(canned{}), Config{Parent: "tank/v", PropertyPrefix: p})
+		cols := ""
+		if ep != nil {
+			cols = strings.Join(ep.names.columns()[11:13], ",")
+		}
+		t.Logf("prefix %q: New err=%v; scan columns include %q", p, err, cols)
+	}
+}
+
+// Partial tables are Tables: a planner that reads absence from a scan of
+// one volume plans a destroy without seeing clones elsewhere.
+func TestReachPartialTableDelete(t *testing.T) {
+	src := vol("src", nil)
+	s := snap("src@s", func(r *Row) { r.Own, r.SnapshotName = Foreign, "" }) // an admin snapshot
+	clone := vol("other", func(r *Row) { r.Origin = "tank/v/src@s" })
+	full := NewTable([]Row{src, s, clone})
+	partial := NewTable([]Row{src, s}) // what scan("src") returns
+	_, errFull := pl.PlanDeleteVolume(FullTable{full}, "src")
+	planPartial, errPartial := pl.PlanDeleteVolume(FullTable{partial}, "src")
+	t.Logf("full: err=%v; partial: plan=%v err=%v", errFull, planPartial, errPartial)
+}
