+// ---- construction: only table.go builds production state ------------------
+
+// Row, FullTable and whole-coverage Tables are built only in table.go
+// (decode, scanAll, afterDestroy). Go's privacy boundary is the package,
+// so within it this test is what makes "parse once" hold: a planner that
+// fabricates a Row, or promotes a partial table to a FullTable, fails here.
+func TestOnlyTableGoBuildsState(t *testing.T) {
+	fset := token.NewFileSet()
+	files, _ := filepath.Glob("*.go")
+	for _, f := range files {
+		if strings.HasSuffix(f, "_test.go") || f == "table.go" {
+			continue
+		}
+		af, err := parser.ParseFile(fset, f, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(af, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.CompositeLit:
+				if id, ok := x.Type.(*ast.Ident); ok && (id.Name == "Row" || id.Name == "FullTable") && len(x.Elts) > 0 {
+					t.Errorf("%s: %s literal outside table.go", fset.Position(x.Pos()), id.Name)
+				}
+			case *ast.CallExpr:
+				if id, ok := x.Fun.(*ast.Ident); ok && id.Name == "NewTable" {
+					t.Errorf("%s: NewTable (whole coverage) outside table.go", fset.Position(x.Pos()))
+				}
+			}
+			return true
+		})
+	}
+}
+
+// ---- compile-time: removed states do not compile --------------------------
+
+// Each snippet is a state the old shapes allowed. They are added to the
+// package with `go build -overlay`, so the real compiler is the judge.
+func TestBadStatesDoNotCompile(t *testing.T) {
+	if testing.Short() {
+		t.Skip("runs the go command")
+	}
+	bad := []struct{ code, want string }{
+		{`var _ = Row{Managed: true}`, "unknown field Managed"},
+		{`func _(r Row) bool { return r.Committed }`, "r.Committed undefined"},
+		{`func _(t Table) { Planner{}.PlanDeleteVolume(t, "a") }`, "cannot use t (variable of struct type Table) as FullTable value"},
+		{`func _(t Table) { Planner{}.PlanCreateSnapshot(t, "s", "a") }`, "cannot use t (variable of struct type Table) as FullTable value"},
+		{`func _(t Table) { Planner{}.PlanReconcile(t, Desired{}) }`, "cannot use t (variable of struct type Table) as FullTable value"},
+		{`func _(e *Endpoint) { e.scan(nil, "") }`, "e.scan undefined"},
+		{`func _(t Table) { Planner{}.sizeOps("a", Row{}, CreateVolumeRequest{}, 0) }`, "cannot use Row{} (value of struct type Row) as sizing value"},
+	}
+	var src strings.Builder
+	src.WriteString("package endpoint\n")
+	for _, b := range bad {
+		src.WriteString(b.code + "\n")
+	}
+	out, err := buildWith(t, src.String())
+	if err == nil {
+		t.Fatal("the bad states compiled")
+	}
+	for _, b := range bad {
+		if !strings.Contains(out, b.want) {
+			t.Errorf("%s: want %q in:\n%s", b.code, b.want, out)
+		}
+	}
+	// control: the same harness accepts the intended shapes
+	good := "package endpoint\n" +
+		`func _(t FullTable) { Planner{}.PlanDeleteVolume(t, "a"); Planner{}.PlanDeleteSnapshot(t.Table, "a@s") }` + "\n" +
+		`func _(r Row) bool { return r.Own == VolCommitted }` + "\n"
+	if out, err := buildWith(t, good); err != nil {
+		t.Fatalf("control did not compile: %v\n%s", err, out)
+	}
+}
+
+func buildWith(t *testing.T, src string) (string, error) {
+	t.Helper()
+	dir := t.TempDir()
+	pkg, err := filepath.Abs(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(dir, "zz_overlay.go")
+	if err := os.WriteFile(file, []byte(src), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ov, _ := json.Marshal(map[string]map[string]string{"Replace": {filepath.Join(pkg, "zz_overlay.go"): file}})
+	ovFile := filepath.Join(dir, "overlay.json")
+	if err := os.WriteFile(ovFile, ov, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "build", "-gcflags=-e", "-overlay="+ovFile, ".")
+	cmd.Dir = pkg
+	b, err := cmd.CombinedOutput()
+	return string(b), err
+}
