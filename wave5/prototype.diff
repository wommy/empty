+// ---- ownership: one classifier, total over the marker space ---------------
+
+// The predicates the fix builder wrote (A1-4), kept here as the reference
+// the enum must agree with.
+func oldOwnedVolume(typ zfs.Type, id string, m markers) bool {
+	return typ != zfs.TypeSnapshot && m.managed && (m.volName == "" || m.volName == id)
+}
+
+func oldOwnedSnapshot(typ zfs.Type, id string, m markers) bool {
+	vol, _, _ := strings.Cut(id, "@")
+	return typ == zfs.TypeSnapshot && m.managed && m.snapName != "" && (m.snapSrc == "" || m.snapSrc == vol)
+}
+
+func TestClassifyIsTotalAndAgreesWithThePredicates(t *testing.T) {
+	type shape struct {
+		typ zfs.Type
+		id  string
+	}
+	shapes := []shape{
+		{zfs.TypeFilesystem, "a"}, {zfs.TypeVolume, "a"},
+		{zfs.TypeSnapshot, "a@s"}, {zfs.TypeSnapshot, "a@" + cloneSourceSnapshotPrefix + "b"},
+	}
+	n := 0
+	for _, sh := range shapes {
+		for _, managed := range []bool{false, true} {
+			for _, success := range []bool{false, true} {
+				for _, volName := range []string{"", "a", "other"} {
+					for _, snapName := range []string{"", "s"} {
+						for _, snapSrc := range []string{"", "a", "other"} {
+							n++
+							m := markers{managed, success, volName, snapName, snapSrc}
+							o := classify(sh.typ, sh.id, m)
+							isSnap := sh.typ == zfs.TypeSnapshot
+							switch o {
+							case VolUncommitted, VolCommitted:
+								if isSnap {
+									t.Fatalf("%v %+v: snapshot classified %s", sh, m, o)
+								}
+								if (o == VolCommitted) != success {
+									t.Fatalf("%v %+v: %s disagrees with provision_success", sh, m, o)
+								}
+							case SnapCSI, SnapCloneSource:
+								if !isSnap {
+									t.Fatalf("%v %+v: volume classified %s", sh, m, o)
+								}
+							case Foreign:
+							default:
+								t.Fatalf("%v %+v: unnamed Own %d", sh, m, o)
+							}
+							if got, want := o == VolUncommitted || o == VolCommitted, oldOwnedVolume(sh.typ, sh.id, m); got != want {
+								t.Fatalf("%v %+v: owned volume %v, predicate %v", sh, m, got, want)
+							}
+							if got, want := o == SnapCSI, oldOwnedSnapshot(sh.typ, sh.id, m); got != want {
+								t.Fatalf("%v %+v: CSI snapshot %v, predicate %v", sh, m, got, want)
+							}
+							// the one deliberate change: a clone-source name with
+							// a local managed marker is not "internal" (staged
+							// PlanDeleteVolume destroyed it with -r while reconcile
+							// kept it as a CSI snapshot); it is Foreign
+							if o == SnapCloneSource && (m.managed || m.snapName != "") {
+								t.Fatalf("%v %+v: marked snapshot classified as an unmarked clone source", sh, m)
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	if n != 4*2*2*3*2*3 {
+		t.Fatal(n)
+	}
+	if (Row{}).Own != Foreign {
+		t.Fatal("the zero Row must be Foreign")
+	}
+}
+
+// ---- decode: the parse boundary -------------------------------------------
+
+type cannedRunner struct{ out string }
+
+func (c cannedRunner) Run(context.Context, string, ...string) ([]byte, error) {
+	return []byte(c.out), nil
+}
+
+// zget prints `zfs get -Hp` output for datasets: every requested column,
+// "-" unless set. extra is appended raw (forged lines).
+func zget(n props, sets map[string]map[string][2]string, order []string, extra string) string {
+	var b strings.Builder
+	for _, ds := range order {
+		for _, p := range n.columns() {
+			v, ok := sets[ds][p]
+			if !ok {
+				v = [2]string{"-", "-"}
+			}
+			b.WriteString(ds + "\t" + p + "\t" + v[0] + "\t" + v[1] + "\n")
+		}
+	}
+	return b.String() + extra
+}
+
+func cannedEndpoint(t *testing.T, out string) *Endpoint {
+	t.Helper()
+	ep, err := New(zfs.New(cannedRunner{out}), Config{Parent: "tank/v"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ep
+}
+
+func baseRows(n props) (map[string]map[string][2]string, []string) {
+	fs := func() map[string][2]string {
+		return map[string][2]string{"type": {"filesystem", "-"}, "creation": {"1700000000", "-"}}
+	}
+	sets := map[string]map[string][2]string{"tank/v": fs(), "tank/v/a": fs()}
+	for k, v := range map[string][2]string{
+		n.managed(): {"true", "local"}, n.success(): {"true", "local"}, n.volumeName(): {"a", "local"},
+	} {
+		sets["tank/v/a"][k] = v
+	}
+	return sets, []string{"tank/v", "tank/v/a"}
+}
+
+func TestDecodeRejectsWhatZfsNeverPrints(t *testing.T) {
+	n := props{DefaultPropertyPrefix}
+	sets, order := baseRows(n)
+	if vols, _, err := cannedEndpoint(t, zget(n, sets, order, "")).ListVolumes(context.Background(), 0, ""); err != nil || len(vols) != 1 {
+		t.Fatalf("control: %v %v", vols, err)
+	}
+	forge := func(ds string, kv ...string) string {
+		var b strings.Builder
+		for i := 0; i < len(kv); i += 2 {
+			b.WriteString(ds + "\t" + kv[i] + "\t" + kv[i+1] + "\tlocal\n")
+		}
+		return b.String()
+	}
+	for name, extra := range map[string]string{
+		// a newline in a user property value prints lines for a name that
+		// does not exist; nothing collides, so parseColumns accepts them
+		"phantom snapshot-named volume": forge("tank/v/a@ghost", n.managed(), "true", n.success(), "true"),
+		"phantom volume without type":   forge("tank/v/ghost", n.managed(), "true", n.success(), "true"),
+		"filesystem with @":             forge("tank/v/b@x", "type", "filesystem", "creation", "1700000000"),
+		"snapshot without @":            forge("tank/v/b", "type", "snapshot", "creation", "1700000000"),
+		"bookmark":                      forge("tank/v/a#b", "type", "bookmark", "creation", "1700000000"),
+		"volsize not a number":          forge("tank/v/z", "type", "volume", "creation", "1700000000", "volsize", "12x"),
+	} {
+		_, _, err := cannedEndpoint(t, zget(n, sets, order, extra)).ListVolumes(context.Background(), 0, "")
+		if CodeOf(err) != Internal {
+			t.Errorf("%s: want the scan refused (Internal), got %v", name, err)
+		}
+	}
+}
+
+// Columns a type does not have stay zero, even when a user property of
+// that name is set locally on the row (zfs allows user properties on
+// snapshots, and any property name on any dataset).
+func TestDecodeZeroesColumnsTheTypeDoesNotHave(t *testing.T) {
+	n := props{DefaultPropertyPrefix}
+	sets, order := baseRows(n)
+	sets["tank/v/a"][n.snapshotName()] = [2]string{"stray", "local"}
+	sets["tank/v/a@s"] = map[string][2]string{
+		"type": {"snapshot", "-"}, "creation": {"1700000001", "-"},
+		n.managed(): {"true", "local"}, n.snapshotName(): {"s", "local"},
+		n.volumeName(): {"a", "local"}, n.nfsClients(): {"10.0.0.1=rw", "local"},
+		"compression": {"lz4", "local"}, "refquota": {"1024", "local"}, "mountpoint": {"/x", "local"},
+	}
+	order = append(order, "tank/v/a@s")
+	tab, err := cannedEndpoint(t, zget(n, sets, order, "")).scanAll(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, _ := tab.Get("a")
+	s, _ := tab.Get("a@s")
+	if a.Own != VolCommitted || a.SnapshotName != "" {
+		t.Errorf("volume: %+v", a)
+	}
+	if s.Own != SnapCSI || s.VolumeName != "" || s.NFSClientsSet || s.Local != (LocalProps{}) || s.Refquota != 0 || s.Mount != "" {
+		t.Errorf("snapshot carries volume columns: %+v", s)
+	}
+}
