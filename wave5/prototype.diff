+package endpoint
+
+// Layout options for wave5/impossible-types.md, measured on the dod3 10k
+// fixture (501 filesystems, 500 zvols, 9000 snapshots):
+//
+//	flat    today's Row: one fat struct for every kind
+//	split   kind-split arrays: []VolRow and []SnapRow, each holding only its
+//	        kind's columns; snapshots-of-volume is a contiguous range found
+//	        by binary search instead of a map of index slices
+//	ptr     Row{common; Vol *volCols; Snap *snapCols}: optional groups
+//
+// Run: ZFS_FIXTURE=.../dod3/fixture.10k go test -run x -bench Layout -benchmem
+
+import (
+	"context"
+	"os"
+	"slices"
+	"strings"
+	"testing"
+	"unsafe"
+
+	"github.com/wommy/empty/internal/zfs"
+)
+
+type volRow struct {
+	Name, ID                         string
+	Kind                             VolumeKind
+	Own                              Own
+	Volsize, Refquota, Refres, BlkSz uint64
+	Origin, Mount                    string
+	Creation                         int64
+	Local                            LocalProps
+	ShareNFS, NFSClients             string
+	ShareNFSLocal, Mounted, NFSSet   bool
+	VolumeName, SourceType, SourceID string
+}
+
+type snapRow struct {
+	Name, ID                     string
+	Own                          Own
+	Deferred                     bool
+	Volsize                      uint64
+	Creation                     int64
+	SnapshotName, SnapshotSource string
+}
+
+type splitTable struct {
+	vols   []volRow
+	snaps  []snapRow
+	clones map[string][]int
+}
+
+func newSplit(rows []Row) splitTable {
+	var t splitTable
+	for _, r := range rows {
+		if r.Type == zfs.TypeSnapshot {
+			t.snaps = append(t.snaps, snapRow{r.Name, r.ID, r.Own, r.Deferred, r.Volsize, r.Creation, r.SnapshotName, r.SnapshotSource})
+		} else {
+			t.vols = append(t.vols, volRow{r.Name, r.ID, r.Kind(), r.Own, r.Volsize, r.Refquota, r.Refres, r.BlockSz, r.Origin, r.Mount,
+				r.Creation, r.Local, r.ShareNFS, r.NFSClients, r.ShareNFSLocal, r.Mounted, r.NFSClientsSet, r.VolumeName, r.SourceType, r.SourceID})
+		}
+	}
+	slices.SortFunc(t.vols, func(a, b volRow) int { return strings.Compare(a.ID, b.ID) })
+	slices.SortFunc(t.snaps, func(a, b snapRow) int { return strings.Compare(a.ID, b.ID) })
+	t.clones = map[string][]int{}
+	for i, v := range t.vols {
+		if v.Origin != "" {
+			t.clones[v.Origin] = append(t.clones[v.Origin], i)
+		}
+	}
+	return t
+}
+
+// snapshotsOf: in ID order, every id with the prefix "<vol>@" is
+// contiguous, so a volume's snapshots are one sub-slice: binary search for
+// the first id >= "<vol>@", then extend while the prefix holds. No map.
+func (t splitTable) snapshotsOf(vol string) []snapRow {
+	p := vol + "@"
+	lo, _ := slices.BinarySearchFunc(t.snaps, p, func(s snapRow, p string) int { return strings.Compare(s.ID, p) })
+	hi := lo
+	for hi < len(t.snaps) && strings.HasPrefix(t.snaps[hi].ID, p) {
+		hi++
+	}
+	return t.snaps[lo:hi]
+}
+
+type volCols struct {
+	Refquota, Refres, BlkSz          uint64
+	Origin, Mount                    string
+	Local                            LocalProps
+	ShareNFS, NFSClients             string
+	ShareNFSLocal, Mounted, NFSSet   bool
+	VolumeName, SourceType, SourceID string
+}
+
+type snapCols struct {
+	Deferred                     bool
+	SnapshotName, SnapshotSource string
+}
+
+type ptrRow struct {
+	Name, ID string
+	Type     zfs.Type
+	Own      Own
+	Volsize  uint64
+	Creation int64
+	Vol      *volCols
+	Snap     *snapCols
+}
+
+func newPtr(rows []Row) []ptrRow {
+	out := make([]ptrRow, len(rows))
+	for i, r := range rows {
+		p := ptrRow{Name: r.Name, ID: r.ID, Type: r.Type, Own: r.Own, Volsize: r.Volsize, Creation: r.Creation}
+		if r.Type == zfs.TypeSnapshot {
+			p.Snap = &snapCols{r.Deferred, r.SnapshotName, r.SnapshotSource}
+		} else {
+			p.Vol = &volCols{r.Refquota, r.Refres, r.BlockSz, r.Origin, r.Mount, r.Local, r.ShareNFS, r.NFSClients, r.ShareNFSLocal, r.Mounted, r.NFSClientsSet, r.VolumeName, r.SourceType, r.SourceID}
+		}
+		out[i] = p
+	}
+	slices.SortFunc(out, func(a, b ptrRow) int { return strings.Compare(a.ID, b.ID) })
+	return out
+}
+
+func fixtureEndpoint(b *testing.B) *Endpoint {
+	path := os.Getenv("ZFS_FIXTURE")
+	if path == "" {
+		b.Skip("set ZFS_FIXTURE to dod3/fixture.10k")
+	}
+	out, err := os.ReadFile(path)
+	if err != nil {
+		b.Fatal(err)
+	}
+	ep, err := New(zfs.New(cannedRunner{string(out)}), Config{Parent: "tank/k8s/vols", PropertyPrefix: "democratic-csi"})
+	if err != nil {
+		b.Fatal(err)
+	}
+	return ep
+}
+
+func BenchmarkLayout(b *testing.B) {
+	ep := fixtureEndpoint(b)
+	full, err := ep.scanAll(context.Background())
+	if err != nil {
+		b.Fatal(err)
+	}
+	rows := slices.Collect(full.All())
+	var vols []string
+	for r := range full.Volumes() {
+		vols = append(vols, r.ID)
+	}
+	b.Logf("rows=%d vols=%d sizeof Row=%d volRow=%d snapRow=%d ptrRow=%d volCols=%d snapCols=%d",
+		len(rows), len(vols), unsafe.Sizeof(Row{}), unsafe.Sizeof(volRow{}), unsafe.Sizeof(snapRow{}),
+		unsafe.Sizeof(ptrRow{}), unsafe.Sizeof(volCols{}), unsafe.Sizeof(snapCols{}))
+
+	b.Run("build/flat", func(b *testing.B) {
+		for b.Loop() {
+			_ = NewTable(slices.Clone(rows))
+		}
+	})
+	b.Run("build/split", func(b *testing.B) {
+		for b.Loop() {
+			_ = newSplit(rows)
+		}
+	})
+	b.Run("build/ptr", func(b *testing.B) {
+		for b.Loop() {
+			_ = newPtr(rows)
+		}
+	})
+
+	flat, split := NewTable(slices.Clone(rows)), newSplit(rows)
+	// a DeleteVolume-shaped read for every volume: its snapshots' ownership
+	b.Run("snapsOf-all-vols/flat", func(b *testing.B) {
+		for b.Loop() {
+			n := 0
+			for _, v := range vols {
+				for s := range flat.SnapshotsOf(v) {
+					if s.Own == SnapCSI && !s.Deferred {
+						n++
+					}
+				}
+			}
+		}
+	})
+	b.Run("snapsOf-all-vols/split", func(b *testing.B) {
+		for b.Loop() {
+			n := 0
+			for _, v := range vols {
+				for _, s := range split.snapshotsOf(v) {
+					if s.Own == SnapCSI && !s.Deferred {
+						n++
+					}
+				}
+			}
+		}
+	})
+	// a ListSnapshots/PlanCreateSnapshot-shaped scan of every snapshot
+	b.Run("scan-snaps/flat", func(b *testing.B) {
+		for b.Loop() {
+			n := 0
+			for r := range flat.All() {
+				if r.Own == SnapCSI && r.SnapshotName == "x" {
+					n++
+				}
+			}
+		}
+	})
+	b.Run("scan-snaps/split", func(b *testing.B) {
+		for b.Loop() {
+			n := 0
+			for _, s := range split.snaps {
+				if s.Own == SnapCSI && s.SnapshotName == "x" {
+					n++
+				}
+			}
+		}
+	})
+}
+
+// BenchmarkScanAllFixture: zfs get output to FullTable, the request path's
+// fixed cost, to set the layout numbers against.
+func BenchmarkScanAllFixture(b *testing.B) {
+	ep := fixtureEndpoint(b)
+	for b.Loop() {
+		if _, err := ep.scanAll(context.Background()); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
