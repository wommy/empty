## create/fs
create-filesystem tank/v/a democratic-csi:csi_volume_name=a democratic-csi:managed_resource=true refquota=1073741824 sharenfs=off sharesmb=off
set tank/v/a democratic-csi:provision_success=true

## create/fs-unlimited
create-filesystem tank/v/a democratic-csi:csi_volume_name=a democratic-csi:managed_resource=true sharenfs=off sharesmb=off
