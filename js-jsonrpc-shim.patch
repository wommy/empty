+++ b/src/driver/freenas/jsonrpc/rest_shim.js
@@ -0,0 +1,308 @@
+// @ts-check
+/**
+ * Serves the REST v2.0 `Client` surface (get/post/put/delete resolving to
+ * {statusCode, body}) over the TrueNAS JSON-RPC API, so the existing
+ * accessors in ../http/api.js, ../api.js and ../ssh.js keep working on
+ * TrueNAS 26+ where REST no longer exists.
+ *
+ * REST v2.0 was itself generated from middleware methods, so the mapping is
+ * mechanical:
+ *
+ *   GET    /a/b              -> a.b.query(filters, options)   (or a.b if a.b is a method)
+ *   GET    /a/b/id/<id>      -> a.b.get_instance(id, options)
+ *   POST   /a/b              -> a.b.create(body)
+ *   POST   /a/b/<verb>       -> a.b.<verb>(...body)
+ *   PUT    /a/b/id/<id>      -> a.b.update(id, body)
+ *   DELETE /a/b/id/<id>      -> a.b.delete(id, ...body)
+ *
+ * Object bodies become positional params using the parameter names generated
+ * from middleware (src/types/truenas/methods.json). Accessors should migrate
+ * to JsonRpcClient.call() directly; this shim is the bridge, not the target.
+ */
+const { JsonRpcError, ConnectionError } = require("./client");
+const METHODS = require("../../../types/truenas/methods.json");
+
+/** @typedef {{statusCode: number, body: any}} RestResponse */
+
+// methods the generated table does not cover but REST v2 callers reach
+/** @type {Record<string, string[]>} */
+const EXTRA_PARAMS = {
+  "system.version": [],
+  "system.info": [],
+  "core.get_jobs": ["filters", "options"],
+};
+
+// REST v1 / pre-SCALE spellings still referenced in the accessors
+/** @type {Record<string, string>} */
+const RESOURCE_ALIASES = {
+  "sharing.cifs": "sharing.smb",
+};
+
+// GET on these resources is a config()/plain call, not query()
+const CONFIG_RESOURCES = new Set(["iscsi.global", "nvmet.global", "nfs", "smb", "ssh"]);
+
+/**
+ * newest generated param table not newer than the server
+ * @param {string|undefined} serverVersion
+ */
+function paramTable(serverVersion) {
+  const versions = Object.keys(METHODS).sort();
+  let pick = versions[versions.length - 1];
+  if (serverVersion) {
+    for (const v of versions) {
+      if (v.localeCompare(serverVersion, undefined, { numeric: true }) <= 0) pick = v;
+    }
+  }
+  return /** @type {Record<string, string[]>} */ (METHODS[pick]);
+}
+
+/**
+ * REST query strings were strings on the wire; middleware models are strict
+ * @param {unknown} v
+ */
+function coerce(v) {
+  if (typeof v !== "string") return v;
+  if (v === "true") return true;
+  if (v === "false") return false;
+  if (/^-?\d+$/.test(v)) return Number(v);
+  if (/^[[{]/.test(v)) {
+    try {
+      return JSON.parse(v);
+    } catch (e) {
+      return v;
+    }
+  }
+  return v;
+}
+
+/**
+ * split REST GET params into JSON-RPC (filters, options)
+ * @param {Record<string, unknown>|null|undefined} data
+ */
+function queryArgs(data) {
+  /** @type {unknown[]} */
+  const filters = [];
+  /** @type {Record<string, any>} */
+  const options = {};
+  for (const [k, raw] of Object.entries(data || {})) {
+    const v = coerce(raw);
+    if (k === "limit" || k === "offset") {
+      options[k] = Number(v);
+    } else if (k === "count" || k === "get") {
+      options[k] = Boolean(v);
+    } else if (k === "sort") {
+      options.order_by = String(v).split(",");
+    } else if (k.startsWith("extra.")) {
+      options.extra = options.extra || {};
+      options.extra[k.slice(6)] = v;
+    } else {
+      filters.push([k, "=", v]);
+    }
+  }
+  return { filters, options };
+}
+
+/**
+ * @param {string} endpoint
+ * @returns {{resource: string, id?: string, verb?: string}}
+ */
+function parseEndpoint(endpoint) {
+  const path = String(endpoint).split("?")[0].replace(/^\/+|\/+$/g, "");
+  const segs = path.split("/").filter(Boolean);
+  const idx = segs.indexOf("id");
+  if (idx >= 0) {
+    return {
+      resource: segs.slice(0, idx).join("."),
+      id: segs.length > idx + 1 ? decodeURIComponent(segs[idx + 1]) : undefined,
+      verb: segs.length > idx + 2 ? segs.slice(idx + 2).join("_") : undefined,
+    };
+  }
+  return { resource: segs.join(".") };
+}
+
+/**
+ * map an object body onto positional params; single-param methods take the
+ * body whole (REST v2 did the same)
+ * @param {string[]} names
+ * @param {unknown} body
+ */
+function positional(names, body) {
+  if (body === undefined || body === null) return [];
+  if (Array.isArray(body)) return body;
+  if (names.length <= 1 || typeof body !== "object") return [body];
+  const obj = /** @type {Record<string, unknown>} */ (body);
+  if (!names.some((n) => n in obj)) {
+    // REST v2 sent the remaining options as the body (e.g. delete options)
+    return [body];
+  }
+  const out = names.map((n) => obj[n]);
+  while (out.length && out[out.length - 1] === undefined) out.pop();
+  return out;
+}
+
+/**
+ * JSON-RPC error -> the REST v2 status the accessors were written against.
+ * Their contract (recovered from every httpClient call site):
+ *   GET    not found      -> 404
+ *   POST   already exists -> 422, body mentions "already exists"
+ *   DELETE not found      -> 422, body mentions "does not exist"
+ * JSON-RPC reports these as errnames, so the text is normalized to match.
+ *
+ * @param {unknown} err
+ * @param {"get"|"post"|"put"|"delete"} verb
+ * @returns {RestResponse}
+ */
+function errorResponse(err, verb) {
+  if (!(err instanceof JsonRpcError)) throw err;
+  let message = String(err.reason || err.message);
+  const text = message.toLowerCase();
+  const fieldErrnos = err.fieldErrnos;
+  const notFound =
+    err.errname === "ENOENT" ||
+    fieldErrnos.includes(2) ||
+    err.code === -6 ||
+    /instancenotfound|does not exist|not found/.test(text);
+  const exists =
+    err.errname === "EEXIST" || fieldErrnos.includes(17) || /already exists/.test(text);
+
+  let statusCode = 500;
+  if (notFound) {
+    statusCode = verb == "get" ? 404 : 422;
+    if (!/does not exist/.test(text)) message += " (does not exist)";
+  } else if (exists) {
+    statusCode = 422;
+    if (!/already exists/.test(text)) message += " (already exists)";
+  } else if (err.errname === "EINVAL" || Array.isArray(err.extra)) {
+    statusCode = 422;
+  }
+  return {
+    statusCode,
+    body: { message, errname: err.errname, extra: err.extra },
+  };
+}
+
+class RestOverJsonRpc {
+  /**
+   * @param {import("./client").JsonRpcClient} rpc
+   * @param {{logger?: any}} [options]
+   */
+  constructor(rpc, options = {}) {
+    this.rpc = rpc;
+    this.logger = options.logger || rpc.logger;
+  }
+
+  async params() {
+    let version;
+    try {
+      version = await this.rpc.getServerApiVersion();
+    } catch (e) {
+      version = undefined;
+    }
+    return { ...EXTRA_PARAMS, ...paramTable(version) };
+  }
+
+  /**
+   * @param {"get"|"post"|"put"|"delete"} verb
+   * @param {string} method
+   * @param {unknown[]} params
+   * @returns {Promise<RestResponse>}
+   */
+  async invoke(verb, method, params) {
+    this.logger.debug("TRUENAS JSONRPC CALL: %s %j", method, params);
+    try {
+      const result = await this.rpc.callUntyped(method, params);
+      return { statusCode: 200, body: result };
+    } catch (err) {
+      if (err instanceof ConnectionError) throw err;
+      const res = errorResponse(err, verb);
+      this.logger.debug("TRUENAS JSONRPC ERROR: %s %d %j", method, res.statusCode, res.body);
+      return res;
+    }
+  }
+
+  /**
+   * @param {string} resource
+   */
+  resolve(resource) {
+    return RESOURCE_ALIASES[resource] || resource;
+  }
+
+  /**
+   * @param {string} endpoint
+   * @param {Record<string, unknown>|null} [data]
+   */
+  async get(endpoint, data) {
+    const { resource, id } = parseEndpoint(endpoint);
+    const res = this.resolve(resource);
+    const table = await this.params();
+    const { filters, options } = queryArgs(data);
+    if (id !== undefined) {
+      return this.invoke("get", `${res}.get_instance`, [coerceId(id), options]);
+    }
+    if (CONFIG_RESOURCES.has(res)) {
+      return this.invoke("get", `${res}.config`, []);
+    }
+    if (table[res]) {
+      // a method in its own right, e.g. system.version, core.get_jobs
+      return this.invoke("get", res, table[res].length ? [filters, options] : []);
+    }
+    return this.invoke("get", `${res}.query`, [filters, options]);
+  }
+
+  /**
+   * @param {string} endpoint
+   * @param {unknown} [data]
+   */
+  async post(endpoint, data) {
+    const { resource, id, verb } = parseEndpoint(endpoint);
+    const res = this.resolve(resource);
+    const table = await this.params();
+    if (id !== undefined) {
+      // POST /a/b/id/<id>/<verb>
+      const method = `${res}.${verb}`;
+      return this.invoke("post", method, [coerceId(id), ...positional((table[method] || []).slice(1), data)]);
+    }
+    const method = table[res] ? res : `${res}.create`;
+    return this.invoke("post", method, positional(table[method] || ["data"], data));
+  }
+
+  /**
+   * @param {string} endpoint
+   * @param {unknown} [data]
+   */
+  async put(endpoint, data) {
+    const { resource, id } = parseEndpoint(endpoint);
+    const res = this.resolve(resource);
+    if (id === undefined) {
+      // PUT on a config resource
+      return this.invoke("put", `${res}.update`, [data]);
+    }
+    return this.invoke("put", `${res}.update`, [coerceId(id), data]);
+  }
+
+  /**
+   * @param {string} endpoint
+   * @param {unknown} [data]
+   */
+  async delete(endpoint, data) {
+    const { resource, id } = parseEndpoint(endpoint);
+    const res = this.resolve(resource);
+    const table = await this.params();
+    const method = `${res}.delete`;
+    return this.invoke("delete", method, [coerceId(id), ...positional((table[method] || []).slice(1), data)]);
+  }
+}
+
+/**
+ * numeric ids (shares, targets, extents) are ints; dataset/snapshot ids are names
+ * @param {string|undefined} id
+ */
+function coerceId(id) {
+  return id !== undefined && /^\d+$/.test(id) ? Number(id) : id;
+}
+
+module.exports.RestOverJsonRpc = RestOverJsonRpc;
+module.exports.parseEndpoint = parseEndpoint;
+module.exports.queryArgs = queryArgs;
+module.exports.positional = positional;
+module.exports.errorResponse = errorResponse;
