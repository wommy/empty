+  }
+
+  /**
+   * Untyped escape hatch for methods outside the generated table.
+   *
+   * @param {string} method
+   * @param {unknown[]} [params]
+   * @returns {Promise<any>}
+   */
+  async callUntyped(method, params = []) {
+    await this._acquire();
+    try {
+      return await this._callOnce(method, params);
+    } finally {
+      this._release();
+    }
+  }
+
+  /**
+   * @param {string} method
+   * @param {unknown[]} params
+   */
+  async _callOnce(method, params) {
+    const ws = await this.connect();
+    try {
+      return await this._sendRetryingBusy(ws, method, params);
+    } catch (err) {
+      if (err instanceof JsonRpcError && err.notAuthenticated) {
+        this.logger.info("truenas jsonrpc session expired, re-authenticating");
+        try {
+          await this._authenticate(ws);
+        } catch (authErr) {
+          // drop the socket so the next call starts clean instead of looping
+          ws.terminate();
+          throw authErr;
+        }
+        return await this._sendRetryingBusy(ws, method, params);
+      }
+      throw err;
+    }
+  }
+
+  /**
+   * other clients share the server's limit, so back off on rejection too
+   * @param {WebSocket} ws
+   * @param {string} method
+   * @param {unknown[]} params
+   */
+  async _sendRetryingBusy(ws, method, params) {
+    for (let attempt = 0; ; attempt++) {
+      try {
+        return await this._send(ws, method, params);
+      } catch (err) {
+        if (!(err instanceof JsonRpcError && err.tooManyConcurrentCalls) || attempt >= 5) {
+          throw err;
+        }
+        await new Promise((r) => setTimeout(r, 100 * 2 ** attempt));
+      }
+    }
+  }
+
+  close() {
+    this.closed = true;
+    this._stopPing();
+    if (this.ws) {
+      const ws = this.ws;
+      this._onClose(ws, "client closed");
+      ws.close();
+    }
+  }
+}
