diff --git a/src/driver/freenas/jsonrpc/client.js b/src/driver/freenas/jsonrpc/client.js
new file mode 100644
index 0000000..6b4794c
--- /dev/null
+++ b/src/driver/freenas/jsonrpc/client.js
@@ -0,0 +1,456 @@
+// @ts-check
+const http = require("http");
+const https = require("https");
+const WebSocket = require("ws");
+
+/** @typedef {import("../../../types/truenas").MethodName} MethodName */
+/**
+ * @template {MethodName} M
+ * @typedef {import("../../../types/truenas").Params<M>} Params
+ */
+/**
+ * @template {MethodName} M
+ * @typedef {import("../../../types/truenas").Result<M>} Result
+ */
+
+/**
+ * @typedef {object} JsonRpcClientOptions
+ * @property {string} host
+ * @property {number|string} [port]
+ * @property {"http"|"https"} [protocol]
+ * @property {string} [apiKey]
+ * @property {string} [username]
+ * @property {string} [password]
+ * @property {boolean} [allowInsecure]
+ * @property {number} [requestTimeout] ms, per call
+ * @property {number} [pingInterval] ms, 0 disables
+ * @property {number} [maxInFlight] concurrent calls per connection
+ * @property {Console|{debug: Function, info: Function, warn: Function, error: Function}} [logger]
+ */
+
+// the oldest API this transport is written against; REST is removed in 26
+const MIN_API_VERSION = "v25.10.0";
+
+// middlewared ErrnoMixin.ENOTAUTHENTICATED
+const ERRNO_NOT_AUTHENTICATED = 207;
+
+// truenas_api_client.jsonrpc.JSONRPCError
+const TRUENAS_TOO_MANY_CONCURRENT_CALLS = -32000;
+
+// middleware serves each connection through SoftHardSemaphore(10, 20) and
+// rejects past the hard limit; stay under the soft limit instead
+const DEFAULT_MAX_IN_FLIGHT = 8;
+
+class JsonRpcError extends Error {
+  /**
+   * @param {string} method
+   * @param {{code: number, message: string, data?: any}} error
+   */
+  constructor(method, error) {
+    const data = error.data || {};
+    super(`${method}: ${data.reason || error.message}`);
+    this.name = "JsonRpcError";
+    this.method = method;
+    this.code = error.code;
+    /** @type {string|undefined} e.g. ENOENT, EINVAL, EEXIST */
+    this.errname = data.errname;
+    /** @type {number|undefined} */
+    this.errno = data.error;
+    /** @type {string|undefined} */
+    this.reason = data.reason;
+    /** validation errors: [[attribute, message, errno], ...] */
+    this.extra = data.extra;
+  }
+
+  get tooManyConcurrentCalls() {
+    return this.code === TRUENAS_TOO_MANY_CONCURRENT_CALLS;
+  }
+
+  /**
+   * errnos of the individual validation failures; ValidationErrors arrive as
+   * EINVAL with the specific errno (EEXIST, ENOENT, ...) per field in extra
+   * @returns {number[]}
+   */
+  get fieldErrnos() {
+    if (!Array.isArray(this.extra)) return [];
+    return this.extra
+      .filter((e) => Array.isArray(e) && typeof e[2] === "number")
+      .map((e) => e[2]);
+  }
+
+  get notAuthenticated() {
+    return (
+      this.errno === ERRNO_NOT_AUTHENTICATED ||
+      this.errname === "ENOTAUTHENTICATED" ||
+      String(this.message).toUpperCase().includes("ENOTAUTHENTICATED")
+    );
+  }
+}
+
+class ConnectionError extends Error {
+  /** @param {string} message */
+  constructor(message) {
+    super(message);
+    this.name = "ConnectionError";
+  }
+}
+
+/**
+ * compare "v25.10.0" style versions numerically; RC/BETA suffixes sort with
+ * their numeric prefix
+ * @param {string} a
+ * @param {string} b
+ */
+function compareApiVersions(a, b) {
+  const pa = String(a).replace(/^v/, "").split(/[.-]/).map(Number);
+  const pb = String(b).replace(/^v/, "").split(/[.-]/).map(Number);
+  for (let i = 0; i < 3; i++) {
+    const d = (pa[i] || 0) - (pb[i] || 0);
+    if (d) return d;
+  }
+  return 0;
+}
+
+class JsonRpcClient {
+  /** @param {JsonRpcClientOptions} options */
+  constructor(options) {
+    this.options = {
+      requestTimeout: 60 * 1000,
+      pingInterval: 30 * 1000,
+      maxInFlight: DEFAULT_MAX_IN_FLIGHT,
+      ...options,
+    };
+    this.inFlight = 0;
+    /** @type {Array<() => void>} */
+    this.waiters = [];
+    this.logger = this.options.logger || console;
+    /** @type {WebSocket|null} */
+    this.ws = null;
+    /** @type {Promise<WebSocket>|null} */
+    this.connecting = null;
+    this.nextId = 1;
+    /** @type {Map<number, {method: string, resolve: Function, reject: Function, timer: NodeJS.Timeout}>} */
+    this.pending = new Map();
+    /** @type {NodeJS.Timeout|null} */
+    this.pingTimer = null;
+    /** @type {string[]|null} */
+    this.supportedVersions = null;
+    this.closed = false;
+  }
+
+  getProtocol() {
+    if (this.options.protocol) return this.options.protocol;
+    return String(this.options.port || "").includes("443") ? "https" : "http";
+  }
+
+  getOrigin() {
+    const port = this.options.port ? `:${this.options.port}` : "";
+    return `${this.options.host}${port}`;
+  }
+
+  getUrl() {
+    const scheme = this.getProtocol() == "https" ? "wss" : "ws";
+    // the server's native API; truenas-csi found the older-version compat
+    // adapters unreliable, so callers branch on the reported version instead
+    return `${scheme}://${this.getOrigin()}/api/current`;
+  }
+
+  /**
+   * GET /api/versions (plain HTTP, unauthenticated)
+   * @returns {Promise<string[]>}
+   */
+  async getSupportedVersions() {
+    if (this.supportedVersions) return this.supportedVersions;
+    const mod = this.getProtocol() == "https" ? https : http;
+    const url = `${this.getProtocol()}://${this.getOrigin()}/api/versions`;
+    const body = await new Promise((resolve, reject) => {
+      const req = mod.get(
+        url,
+        { rejectUnauthorized: !this.options.allowInsecure, timeout: 10 * 1000 },
+        (res) => {
+          let data = "";
+          res.on("data", (c) => (data += c));
+          res.on("end", () => {
+            if (res.statusCode != 200) {
+              reject(new ConnectionError(`GET ${url}: HTTP ${res.statusCode}`));
+            } else {
+              resolve(data);
+            }
+          });
+        }
+      );
+      req.on("timeout", () => req.destroy(new ConnectionError(`GET ${url}: timeout`)));
+      req.on("error", reject);
+    });
+    const versions = JSON.parse(body);
+    if (!Array.isArray(versions)) {
+      throw new ConnectionError(`GET ${url}: unexpected response`);
+    }
+    this.supportedVersions = versions.map(String);
+    return this.supportedVersions;
+  }
+
+  /** newest API version the server advertises */
+  async getServerApiVersion() {
+    const versions = await this.getSupportedVersions();
+    return versions.slice().sort(compareApiVersions).pop();
+  }
+
+  async assertSupportedServer() {
+    const newest = await this.getServerApiVersion();
+    if (!newest || compareApiVersions(newest, MIN_API_VERSION) < 0) {
+      throw new ConnectionError(
+        `TrueNAS JSON-RPC transport requires API ${MIN_API_VERSION} or newer (server advertises: ${(
+          this.supportedVersions || []
+        ).join(", ")})`
+      );
+    }
+  }
+
+  /** @returns {Promise<WebSocket>} */
+  async connect() {
+    if (this.closed) throw new ConnectionError("client closed");
+    if (this.ws && this.ws.readyState === WebSocket.OPEN) return this.ws;
+    if (!this.connecting) {
+      this.connecting = this._connect().finally(() => {
+        this.connecting = null;
+      });
+    }
+    return this.connecting;
+  }
+
+  /** @returns {Promise<WebSocket>} */
+  async _connect() {
+    const url = this.getUrl();
+    this.logger.debug("truenas jsonrpc connecting: %s", url);
+    /** @type {WebSocket} */
+    const ws = await new Promise((resolve, reject) => {
+      const sock = new WebSocket(url, {
+        rejectUnauthorized: !this.options.allowInsecure,
+        handshakeTimeout: 15 * 1000,
+        // large query results (datasets with many snapshots)
+        maxPayload: 64 * 1024 * 1024,
+      });
+      sock.once("open", () => resolve(sock));
+      sock.once("error", reject);
+    });
+    ws.on("message", (raw) => this._onMessage(raw));
+    ws.on("close", () => this._onClose(ws, "connection closed"));
+    ws.on("error", (err) => {
+      this.logger.warn("truenas jsonrpc socket error: %s", err.message);
+    });
+    this.ws = ws;
+    try {
+      await this._authenticate(ws);
+    } catch (err) {
+      ws.terminate();
+      this._onClose(ws, "authentication failed");
+      throw err;
+    }
+    this._startPing(ws);
+    return ws;
+  }
+
+  /** @param {WebSocket} ws */
+  async _authenticate(ws) {
+    const { apiKey, username, password } = this.options;
+    let ok;
+    if (apiKey) {
+      ok = await this._send(ws, "auth.login_with_api_key", [apiKey]);
+    } else if (username && password) {
+      ok = await this._send(ws, "auth.login", [username, password]);
+    } else {
+      throw new ConnectionError("truenas jsonrpc: apiKey or username/password required");
+    }
+    if (ok !== true) {
+      throw new ConnectionError("truenas jsonrpc: authentication rejected");
+    }
+  }
+
+  /** @param {WebSocket} ws */
+  _startPing(ws) {
+    if (!this.options.pingInterval) return;
+    this._stopPing();
+    // an API call rather than a protocol ping: it exercises the session too
+    this.pingTimer = setInterval(() => {
+      if (ws !== this.ws) return this._stopPing();
+      this._send(ws, "core.ping", [], 10 * 1000).catch((err) => {
+        this.logger.warn("truenas jsonrpc ping failed, dropping connection: %s", err.message);
+        ws.terminate();
+      });
+    }, this.options.pingInterval);
+    this.pingTimer.unref();
+  }
+
+  _stopPing() {
+    if (this.pingTimer) clearInterval(this.pingTimer);
+    this.pingTimer = null;
+  }
+
+  /**
+   * @param {WebSocket} ws
+   * @param {string} reason
+   */
+  _onClose(ws, reason) {
+    if (ws !== this.ws) return;
+    this.ws = null;
+    this._stopPing();
+    for (const [id, p] of this.pending) {
+      clearTimeout(p.timer);
+      p.reject(new ConnectionError(`${p.method}: ${reason}`));
+      this.pending.delete(id);
+    }
+  }
+
+  /** @param {WebSocket.RawData} raw */
+  _onMessage(raw) {
+    let msg;
+    try {
+      msg = JSON.parse(raw.toString());
+    } catch (err) {
+      this.logger.warn("truenas jsonrpc: unparseable message");
+      return;
+    }
+    // notifications (collection_update etc) carry no id
+    if (msg.id === undefined || msg.id === null) return;
+    const p = this.pending.get(msg.id);
+    if (!p) return;
+    this.pending.delete(msg.id);
+    clearTimeout(p.timer);
+    if (msg.error) {
+      p.reject(new JsonRpcError(p.method, msg.error));
+    } else {
+      p.resolve(msg.result);
+    }
+  }
+
+  /**
+   * @param {WebSocket} ws
+   * @param {string} method
+   * @param {unknown[]} params
+   * @param {number} [timeout]
+   * @returns {Promise<any>}
+   */
+  _send(ws, method, params, timeout = this.options.requestTimeout) {
+    return new Promise((resolve, reject) => {
+      const id = this.nextId++;
+      const timer = setTimeout(() => {
+        if (this.pending.delete(id)) {
+          reject(new ConnectionError(`${method}: timeout after ${timeout}ms`));
+        }
+      }, timeout);
+      this.pending.set(id, { method, resolve, reject, timer });
+      ws.send(JSON.stringify({ jsonrpc: "2.0", id, method, params }), (err) => {
+        if (err && this.pending.delete(id)) {
+          clearTimeout(timer);
+          reject(new ConnectionError(`${method}: ${err.message}`));
+        }
+      });
+    });
+  }
+
+  async _acquire() {
+    if (this.inFlight < (this.options.maxInFlight || DEFAULT_MAX_IN_FLIGHT)) {
+      this.inFlight++;
+      return;
+    }
+    await new Promise((resolve) => this.waiters.push(() => resolve(undefined)));
+  }
+
+  _release() {
+    const next = this.waiters.shift();
+    if (next) {
+      next(); // hand the slot over
+    } else {
+      this.inFlight--;
+    }
+  }
+
+  /**
+   * Call a JSON-RPC method. Re-authenticates once if the server reports the
+   * session expired while the socket stayed open.
+   *
+   * @template {MethodName} M
+   * @param {M} method
+   * @param {Params<M>} params
+   * @returns {Promise<Result<M>>}
+   */
+  async call(method, params) {
