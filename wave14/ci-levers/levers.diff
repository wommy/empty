diff --git a/ci/test-times.awk b/ci/test-times.awk
index 69ed075..e65c660 100644
--- a/ci/test-times.awk
+++ b/ci/test-times.awk
@@ -5,2 +5,5 @@
-# cost_s   own_s plus every parallel (PAUSEd) descendant's own time: the
-#          test-seconds it puts on the shard, parallel subtests summed.
+# cost_s   own_s plus the own time of every parallel (PAUSEd) descendant
+#          that own_s leaves out: the test-seconds it puts on the shard,
+#          parallel subtests summed. A parallel subtest under a sequential
+#          subtest (TestModel/seqs/w0) is already inside own_s, since t.Run
+#          of the sequential one waits for it, and is not added again.
@@ -49,0 +53,14 @@ $1 == "---" && $2 ~ /^(PASS|FAIL|SKIP):$/ {
+# the nearest enclosing test that reported a result: a subtest name can
+# itself contain "/" (TestPropertyRoundTrip/filesystem/atime=on)
+function parent(n,  p) {
+  p = n
+  while (sub(/\/[^\/]*$/, "", p)) if (p in dur) return p
+  return p
+}
+# a parallel test's time is outside its parent's result line; it is
+# outside the top-level test's only if every test between them is parallel
+function outside(n,  p) {
+  if (!(n in paused)) return 0
+  p = parent(n)
+  return index(p, "/") == 0 || outside(p)
+}
@@ -56,2 +73 @@ END {
-    # a parallel subtest's time is not inside its parent's result line
-    if (n in paused) extra[t] += dur[n]
+    if (outside(n)) extra[t] += dur[n]
diff --git a/internal/endpoint/props_roundtrip_test.go b/internal/endpoint/props_roundtrip_test.go
index 4a17b42..8989b0c 100644
--- a/internal/endpoint/props_roundtrip_test.go
+++ b/internal/endpoint/props_roundtrip_test.go
@@ -5,0 +6 @@ import (
+	"os"
@@ -7,0 +9 @@ import (
+	"strings"
@@ -67,0 +70,19 @@ func allowlistRows() []propRow {
+// propRTShard reads PROPRT_SHARD=<i>/<n>: this process runs the rows whose
+// index is i mod n. The real-ZFS VM (ci/real-zfs-guest.sh) runs the test in
+// each of its n endpoint shards, so its ~200 real-pool round trips spread
+// over n processes instead of one; ci/check-split.sh checks that every row
+// ran in exactly one shard. Unset, it runs every row (0/1).
+func propRTShard(t *testing.T) (shard, n int) {
+	v := os.Getenv("PROPRT_SHARD")
+	if v == "" {
+		return 0, 1
+	}
+	a, b, ok := strings.Cut(v, "/")
+	shard, err1 := strconv.Atoi(a)
+	n, err2 := strconv.Atoi(b)
+	if !ok || err1 != nil || err2 != nil || n < 1 || shard < 0 || shard >= n {
+		t.Fatalf("PROPRT_SHARD=%q: want <i>/<n> with 0 <= i < n", v)
+	}
+	return shard, n
+}
+
@@ -73,0 +95,9 @@ func TestPropertyRoundTrip(t *testing.T) {
