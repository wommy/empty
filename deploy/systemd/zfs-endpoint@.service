# One zfs-endpoint per parent dataset. The instance is the systemd-escaped
# dataset name:
#
#   systemctl enable --now "zfs-endpoint@$(systemd-escape tank/k8s/vols).service"
#
# serves tank/k8s/vols on /run/zfs-endpoint/sock/tank-k8s-vols/endpoint.sock.
# That is the one socket convention,
# /run/zfs-endpoint/sock/<systemd-escape parent>/endpoint.sock:
# zfs-endpoint's default -listen and `zfs-csi -parent tank/k8s/vols` use
# the same path (deploy/deploy_test.go pins it). Each instance has a socket
# directory of its own, and that directory is all a pod mounts: never
# /run/zfs-endpoint, which holds every instance's lock (ADR 0001 v2, F1).
# zfs-endpoint refuses (78) a -listen whose directory is or contains it.
#
# That socket serves the CSI role only: what zfs-csi calls. Reconcile and
# the NFS export RPCs are served on the admin socket,
# /run/zfs-endpoint/admin/<systemd-escape parent>/endpoint.sock, to root
# (or the daemon's own uid) only; no pod mounts its directory (ADR 0001
# v2, F2). Without -admin-listen those calls are refused.
#
# %i keeps the escapes literally: tank/k8s-vols is served in
# /run/zfs-endpoint/sock/tank-k8s\x2dvols/, backslash and all, so each '-'
# (and any byte outside [A-Za-z0-9:_.]) in the dataset name costs 4
# bytes. A socket path holds at most 107 bytes (sun_path), which leaves 70
# for the escaped name (69 for the admin socket's, admin/ being a byte
# longer than sock/); a longer one exits 78 at startup (no restart), and
# needs a shorter -listen in a drop-in, with zfs-csi -endpoint to match.
#
# For an encrypted parent, add After=zfs-load-key.service (or the matching
# zfs-load-key@ unit) in a drop-in.

[Unit]
Description=ZFS endpoint for dataset %I
Documentation=https://github.com/wommy/empty
# the pool must be imported and its datasets mounted before the parent
# check; zfs-import.target is reached even when an import fails, so the
# daemon also waits (-parent-wait) and the restart policy below retries
After=zfs-import.target zfs-mount.service zfs.target
Wants=zfs-import.target zfs-mount.service
# NFS file export: sharenfs needs a running nfs-server, and etab is read back
After=nfs-server.service
Wants=nfs-server.service
# keep retrying across a late or encrypted pool import instead of giving up
StartLimitIntervalSec=0

[Service]
# READY=1 once serving, STOPPING=1 when draining (sd_notify, no library)
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/zfs-endpoint \
    -parent %I \
    -listen unix:///run/zfs-endpoint/sock/%i/endpoint.sock \
    -admin-listen unix:///run/zfs-endpoint/admin/%i/endpoint.sock \
    -drain 30s \
    -stop-wait 10s \
    -parent-wait 60s
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin

# /run/zfs-endpoint, 0700, shared by all instances: it holds the
# per-parent locks (which must be shared to refuse nested parents) and,
# under sock/, each instance's socket directory, which zfs-endpoint
# creates 0700 itself (its name is the escaped %i, kept out of this
# setting on purpose). Preserve it, so stopping one instance does not
# delete the others' sockets and locks.
RuntimeDirectory=zfs-endpoint
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Shutdown: SIGTERM to the daemon only, never to its zfs children (which
# also run in their own process groups), so in-flight operations finish
# inside -drain. After -drain the daemon cancels the rest and waits up to
# -stop-wait for them; anything still left is SIGKILLed by systemd.
# TimeoutStopSec > drain + stop-wait.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45
# > the version probe (10s) + -parent-wait (60s) + one parent probe (10s)
# + the export check (10s) + the property-prefix check (10s)
TimeoutStartSec=110

# restart with backoff (RestartSteps/RestartMaxDelaySec: systemd >= 254)
Restart=on-failure
RestartSec=2s
RestartSteps=8
RestartMaxDelaySec=60s
# exit 78 = configuration error (bad flags, wrong OpenZFS, a parent that
# is not a filesystem): restarting cannot fix it
RestartPreventExitStatus=78

# Audit: each call and each zfs command is a log line. journald's per-unit
# rate limit (by default 10000 lines per 30s) would drop them under a flood
# of cheap calls, losing the destroys that follow, so it is off for this
# unit (ADR 0001 v2, F8). journald's SystemMaxUse bounds the disk, by
# rotating, not by dropping lines as they come.
LogRateLimitIntervalSec=0

# resource caps (defense in depth beside -max-zfs and MaxConcurrentStreams)
TasksMax=512
LimitNOFILE=65536
OOMScoreAdjust=-500

# Hardening: only options that do NOT create a private mount namespace.
# zfs mounts datasets and exportfs edits host state from inside this
# service; a private namespace (PrivateTmp, ProtectSystem, ProtectHome,
# PrivateDevices, ReadOnlyPaths, ProtectKernel*, ...) would hide every
# mount from the host and from nfsd. zfs-mount.service and zed use none.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# exportfs resolves client hostnames, so keep INET
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target zfs.target
