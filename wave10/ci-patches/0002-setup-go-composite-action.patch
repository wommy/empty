diff --git a/.github/actions/setup-go/action.yml b/.github/actions/setup-go/action.yml
new file mode 100644
index 0000000..17f8f26
--- /dev/null
+++ b/.github/actions/setup-go/action.yml
@@ -0,0 +1,51 @@
+name: setup-go
+description: >-
+  Go toolchain straight from the actions/go-versions release (sha256-pinned),
+  plus the Go build and module caches. Replaces actions/setup-go, which spends
+  about 7s of every job copying the SDK into the runner tool cache and
+  re-saving a 465 MB cache blob. The download overlaps with the cache restore.
+  Restore only: the workflow saves the cache from main (see ci.yml).
+inputs:
+  cache-name:
+    description: Cache namespace, one per job shape (vet-heavy and -race builds share little).
+    required: true
+runs:
+  using: composite
+  steps:
+    - name: start Go download
+      shell: bash
+      env:
+        # bump together: go.mod's toolchain line, this version, the cache key
+        # prefix below, and the sha256 in the install step (sha256sum of the
+        # asset of the matching actions/go-versions release)
+        GO_URL: https://github.com/actions/go-versions/releases/download/1.27.3-39437817176/go-1.27.3-linux-x64.tar.gz
+      run: |
+        rm -f "$RUNNER_TEMP/go.tgz.done"
+        setsid nohup bash -c 'curl -fsSL --retry 3 -o "$1/go.tgz" "$2" && touch "$1/go.tgz.done"' _ "$RUNNER_TEMP" "$GO_URL" >/dev/null 2>&1 &
+    - name: restore Go caches
+      # the key includes the commit so main can save a fresh entry per push;
+      # a restore falls back to the newest entry with the same go.sum, then
+      # to the newest of the namespace (PRs read main's caches)
+      uses: actions/cache/restore@5a3ec84eff668545956fd18022155c47e93e2684 # v4.2.3
+      with:
+        path: |
+          ~/.cache/go-build
+          ~/go/pkg/mod
+        key: go1.27.3-${{ inputs.cache-name }}-${{ hashFiles('go.sum') }}-${{ github.sha }}
+        restore-keys: |
+          go1.27.3-${{ inputs.cache-name }}-${{ hashFiles('go.sum') }}-
+          go1.27.3-${{ inputs.cache-name }}-
+    - name: install Go 1.27.3
+      shell: bash
+      env:
+        GO_SHA256: d0fbe16a6a03fe5fbf5577ab36f95f0725af587820dca8a78e6edd4eb4e19fd6
+      run: |
+        for _ in $(seq 120); do [ -e "$RUNNER_TEMP/go.tgz.done" ] && break; sleep 0.5; done
+        test -e "$RUNNER_TEMP/go.tgz.done" || { echo "::error::Go download did not finish"; exit 1; }
+        echo "$GO_SHA256  $RUNNER_TEMP/go.tgz" | sha256sum -c -
+        mkdir -p "$HOME/sdk/go"
+        tar -xzf "$RUNNER_TEMP/go.tgz" -C "$HOME/sdk/go"
+        echo "$HOME/sdk/go/bin" >> "$GITHUB_PATH"
+        # never switch toolchains: go.mod says go 1.27.0, toolchain go1.27.3
+        echo "GOTOOLCHAIN=local" >> "$GITHUB_ENV"
+        "$HOME/sdk/go/bin/go" version
