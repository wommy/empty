+#!/usr/bin/env bash
+# Runs once inside the guest during ci/vm/bake.sh (cloud-init runcmd, after
+# the packages are installed). Trims the boot, hands the kernel, initrd and
+# provenance to the host over 9p, and switches cloud-init off for good.
+set -euxo pipefail
+want=${1:?openzfs minor}
+
+modprobe zfs
+zfs version
+zfs version | grep -Eq "^zfs-kmod-${want//./\\.}\." || { echo "zfs kmod is not $want.x" >&2; exit 1; }
+for m in 9p 9pnet_virtio; do modprobe "$m"; done
+printf '%s\n' zfs 9p 9pnet_virtio >/etc/modules-load.d/zfsci.conf
+
+systemctl enable nfs-server.service zfsci.service
+# what a test boot never needs; purge or mask only what exists
+for p in snapd unattended-upgrades; do
+  if dpkg -s "$p" >/dev/null 2>&1; then apt-get purge -y -qq "$p"; fi
+done
+for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer man-db.timer \
+  e2scrub_all.timer fstrim.timer fwupd-refresh.timer update-notifier-download.timer \
+  ModemManager.service multipathd.service multipathd.socket lxd-installer.socket; do
+  if systemctl list-unit-files "$u" --no-legend | grep -q .; then systemctl mask "$u"; fi
+done
+apt-get clean
+rm -rf /var/lib/apt/lists/*
+
+mkdir -p /mnt/out
+mount -t 9p -o trans=virtio,version=9p2000.L,msize=524288 out /mnt/out
+k=$(uname -r)
+cp "/boot/vmlinuz-$k" /mnt/out/vmlinuz
+cp "/boot/initrd.img-$k" /mnt/out/initrd.img
+# the cloud image's own command line, minus the loader's BOOT_IMAGE
+sed -E 's/BOOT_IMAGE=[^ ]+ ?//' /proc/cmdline >/mnt/out/cmdline
+mkdir -p /etc/zfsci
+{
+  cat /mnt/out/provenance.host
+  echo "serial=$(sed -n 's/^serial: *//p' /etc/cloud/build.info)"
+  echo "kernel=$k"
+  zfs version | sed -n 's/^zfs-kmod-/zfs_kmod=/p; s/^zfs-\([0-9]\)/zfs=\1/p'
+} >/etc/zfsci/provenance
+cp /etc/zfsci/provenance /mnt/out/provenance
+
+# every later boot is a test boot: no cloud-init, a fresh machine-id
+touch /etc/cloud/cloud-init.disabled
+truncate -s 0 /etc/machine-id
+fstrim -av || true
+sync
+touch /mnt/out/baked
+umount /mnt/out
diff --git a/ci/vm/image/zfsci-boot b/ci/vm/image/zfsci-boot
new file mode 100755
index 0000000..98a15eb
--- /dev/null
+++ b/ci/vm/image/zfsci-boot
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Baked into the guest (ci/vm/bake.sh). On a boot with zfsci=1 on the kernel
+# command line: mount the host's 9p share, wait until the host has built the
+# test binaries, run the guest-run.sh the host put there (the PR's own copy,
+# not a baked one), then power off. The host reads the results from the
+# share; nothing here decides pass or fail.
+set -u
+say() { echo "zfsci: $*"; }
+mkdir -p /mnt/ci
+if ! mount -t 9p -o trans=virtio,version=9p2000.L,msize=524288 ci /mnt/ci; then
+  say "cannot mount the 9p share"
+  systemctl poweroff --no-block
+  exit 1
+fi
+say "up at $(cut -d' ' -f1 /proc/uptime)s, waiting for the test binaries"
+while [ ! -e /mnt/ci/ready ]; do sleep 0.1; done
+say "binaries ready at $(cut -d' ' -f1 /proc/uptime)s"
+mkdir -p /mnt/ci/out
+mode=$(cat /mnt/ci/mode 2>/dev/null || echo full)
+bash /mnt/ci/guest-run.sh "$mode" >/mnt/ci/out/guest.log 2>&1
+rc=$?
+# guest-run.sh writes out/rc as its last act; if it died first, say so
+[ -e /mnt/ci/out/rc ] || echo "$rc" >/mnt/ci/out/rc
+say "done (rc $(cat /mnt/ci/out/rc)) at $(cut -d' ' -f1 /proc/uptime)s"
+sync
+systemctl poweroff --no-block
diff --git a/ci/vm/image/zfsci.service b/ci/vm/image/zfsci.service
new file mode 100644
index 0000000..4652765
--- /dev/null
+++ b/ci/vm/image/zfsci.service
@@ -0,0 +1,17 @@
+[Unit]
+Description=zfs-endpoint CI: run the tests from the host's 9p share
+ConditionKernelCommandLine=zfsci=1
+# nfsd threads and the zfs module must be up before any test runs; network
+# ordering keeps exportfs's name resolution as it was under cloud-init
+Wants=nfs-server.service network-online.target
+After=nfs-server.service network-online.target zfs-load-module.service systemd-modules-load.service
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/sbin/zfsci-boot
+StandardOutput=journal+console
+StandardError=journal+console
+TimeoutStartSec=infinity
+
+[Install]
+WantedBy=multi-user.target
