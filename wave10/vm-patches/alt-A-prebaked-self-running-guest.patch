diff --git a/.github/workflows/vm-image.yml b/.github/workflows/vm-image.yml
new file mode 100644
index 0000000..1b42e24
--- /dev/null
+++ b/.github/workflows/vm-image.yml
@@ -0,0 +1,59 @@
+name: vm-image
+
+# Rebake the real-ZFS VM bundle (ci/vm/bake.sh) every night: the Ubuntu
+# 26.10 "current" image, its kernel and its OpenZFS SRUs move under an
+# unchanged bake script, and so does the runner image under the extracted
+# qemu. The ci workflow restores the newest bake for its inputs hash, and
+# bakes inline (about 90s, once) when there is none. A failed bake leaves
+# the previous bundle in place, opens an issue, and the ci job warns at 7
+# days and fails at 30.
+
+on:
+  schedule:
+    - cron: '41 3 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  issues: write
+
+concurrency:
+  group: vm-image
+  cancel-in-progress: false
+
+defaults:
+  run:
+    shell: bash
+
+jobs:
+  bake:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          persist-credentials: false
+      - name: enable kvm
+        run: |
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+          test -c /dev/kvm || { echo "::error::no /dev/kvm on this runner"; exit 1; }
+      - name: bake (includes a boot-and-assert smoke test)
+        run: |
+          test -s /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg
+          ci/vm/bake.sh stonking current 2.4 "$RUNNER_TEMP/zfsvm-bundle"
+      - name: save VM bundle
+        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
+        with:
+          path: ${{ runner.temp }}/zfsvm-bundle
+          key: zfsvm-v1-ubuntu-24.04-stonking-${{ hashFiles('ci/vm/bake.sh', 'ci/vm/image/**') }}-${{ github.run_id }}
+      - name: open an issue on failure
+        if: failure()
+        env:
+          GH_TOKEN: ${{ github.token }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          gh issue create --repo "$GITHUB_REPOSITORY" --label needs-triage \
+            --title "nightly VM bake failed ($(date -u +%F))" \
+            --body "The real-ZFS VM bake failed: $RUN_URL. PR CI keeps using the previous bundle; it warns after 7 days and fails after 30."
diff --git a/ci/fetch-go.sh b/ci/fetch-go.sh
new file mode 100755
index 0000000..99d1361
--- /dev/null
+++ b/ci/fetch-go.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Fetch the pinned Go toolchain into <dest>, checksum-verified: the same
+# tarball actions/setup-go downloads, without its ~5s copy into the tool
+# cache. Run in the background while the VM boots; writes <dest>/.ok or
+# <dest>/.failed, and logs to <dest>.log.
+#
+# usage: GO_TARBALL_URL=... GO_TARBALL_SHA256=... ci/fetch-go.sh <dest>
+set -euo pipefail
+dest=${1:?destination}
+exec >"$dest.log" 2>&1
+rm -rf "$dest"
+mkdir -p "$dest"
+trap '[ -e "$dest/.ok" ] || touch "$dest/.failed"' EXIT
+curl -fsSL --retry 3 -o "$dest.tgz" "${GO_TARBALL_URL:?}"
+echo "${GO_TARBALL_SHA256:?}  $dest.tgz" | sha256sum -c -
+tar xzf "$dest.tgz" -C "$dest"
+rm -f "$dest.tgz"
+"$dest/bin/go" version
+touch "$dest/.ok"
