diff --git a/ci/qemu-tree.sh b/ci/qemu-tree.sh
new file mode 100755
index 0000000..66ab3f9
--- /dev/null
+++ b/ci/qemu-tree.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+# Build a relocatable qemu tree for the real-ZFS job: the packages apt would
+# add to this runner image for qemu-system-x86 and qemu-utils, downloaded and
+# unpacked with dpkg-deb (no dpkg database, no triggers, no apt-get update on
+# a warm run), plus wrappers in <dir>/bin that point the binaries at the
+# tree's libraries and firmware. The workflow caches <dir> per runner image
+# version; on a cache hit this script only re-verifies it.
+#
+# usage: ci/qemu-tree.sh <dir>
+#   then: export PATH=<dir>/bin:$PATH
+# Exits non-zero if the tree does not run here; the caller then falls back
+# to apt-get install.
+set -euo pipefail
+
+dir=${1:?tree directory}
+
+verify() {
+  "$dir/bin/qemu-system-x86_64" --version | head -n 1 &&
+    "$dir/bin/qemu-img" --version | head -n 1 &&
+    # the firmware a pc boot with virtio-net loads, through the wrapper's -L
+    for f in bios-256k.bin kvmvapic.bin linuxboot_dma.bin vgabios-stdvga.bin efi-virtio.rom; do
+      [ -e "$dir/usr/share/qemu/$f" ] || [ -e "$dir/usr/share/seabios/$f" ] || [ -e "$dir/usr/lib/ipxe/qemu/$f" ] ||
+        { echo "missing firmware $f" >&2; return 1; }
+    done
+}
+
+if [ -x "$dir/bin/qemu-system-x86_64" ]; then
+  verify && exit 0
+  echo "cached qemu tree does not run on this runner image; rebuilding" >&2
+fi
+
+rm -rf "$dir"
+mkdir -p "$dir/debs" "$dir/bin"
+sudo apt-get update -qq
+# exactly what apt would install on this image: no more (no recommends),
+# no less (a library the image lacks)
+mapfile -t pkgs < <(apt-get install -s --no-install-recommends qemu-system-x86 qemu-utils | awk '/^Inst /{ print $2 }')
+if [ "${#pkgs[@]}" -eq 0 ]; then
+  # already installed on this image: take the packages themselves
+  pkgs=(qemu-system-x86 qemu-system-common qemu-system-data qemu-utils seabios ipxe-qemu)
+fi
+chmod 0777 "$dir/debs" # apt downloads as _apt
+(cd "$dir/debs" && apt-get download "${pkgs[@]}" >/dev/null)
+for d in "$dir"/debs/*.deb; do dpkg-deb -x "$d" "$dir"; done
+rm -rf "$dir/debs"
+# absolute links (firmware into /usr/share/seabios, /usr/lib/ipxe) must
+# resolve inside the tree
+find "$dir" -type l -lname '/*' -print0 | while IFS= read -r -d '' l; do
+  ln -sfn "$(realpath -m --relative-to="$(dirname "$l")" "$dir$(readlink "$l")")" "$l"
+done
+# wrappers find the tree from their own path, so a cache restored
+# elsewhere still works
+cat >"$dir/bin/qemu-system-x86_64" <<'EOF'
+#!/bin/sh
+t=$(dirname "$(readlink -f "$0")")/..
+LD_LIBRARY_PATH=$t/usr/lib/x86_64-linux-gnu:$t/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} \
+  QEMU_MODULE_DIR=$t/usr/lib/x86_64-linux-gnu/qemu \
+  exec "$t/usr/bin/qemu-system-x86_64" -L "$t/usr/share/qemu" -L "$t/usr/share/seabios" -L "$t/usr/lib/ipxe/qemu" "$@"
+EOF
+cat >"$dir/bin/qemu-img" <<'EOF'
+#!/bin/sh
+t=$(dirname "$(readlink -f "$0")")/..
+LD_LIBRARY_PATH=$t/usr/lib/x86_64-linux-gnu:$t/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} \
+  exec "$t/usr/bin/qemu-img" "$@"
+EOF
+chmod +x "$dir/bin/qemu-system-x86_64" "$dir/bin/qemu-img"
+printf '%s\n' "${pkgs[@]}" >"$dir/packages"
+verify
diff --git a/ci/real-zfs-cloud-config.yaml b/ci/real-zfs-cloud-config.yaml
new file mode 100644
index 0000000..451a769
--- /dev/null
+++ b/ci/real-zfs-cloud-config.yaml
@@ -0,0 +1,23 @@
+#cloud-config
+# Provisions the real-ZFS guest once (ci/real-zfs-vm.sh, cold run); the
+# result is cached keyed by the image's sha256 and this file's hash, so
+# editing it reprovisions and editing the test runner does not.
+# @SSH_KEY@ is replaced with the run's public key.
+users:
+  - name: ci
+    sudo: ALL=(ALL) NOPASSWD:ALL
+    shell: /bin/bash
+    ssh_authorized_keys: [@SSH_KEY@]
+package_update: true
+packages: [zfsutils-linux, nfs-kernel-server]
+runcmd:
+  - [modprobe, zfs]
+  - [systemctl, enable, --now, nfs-server]
+  # every later (warm) boot: zfs loaded by systemd, nothing on the boot path
+  # the tests do not need. The version, module and nfsd checks run on every
+  # boot regardless
+  - [sh, -c, 'echo zfs >/etc/modules-load.d/zfs.conf']
+  - [sh, -c, 'for p in snapd unattended-upgrades; do if dpkg -s $p >/dev/null 2>&1; then apt-get purge -y -qq $p; fi; done']
+  - [sh, -c, 'for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer man-db.timer e2scrub_all.timer fstrim.timer fwupd-refresh.timer ModemManager.service multipathd.service multipathd.socket lxd-installer.socket; do if systemctl list-unit-files "$u" --no-legend | grep -q .; then systemctl mask "$u"; fi; done']
+  # cloud-init has done its one job; a warm boot skips its four stages
+  - [touch, /etc/cloud/cloud-init.disabled]
diff --git a/ci/real-zfs-guest.sh b/ci/real-zfs-guest.sh
new file mode 100755
index 0000000..ae15c03
--- /dev/null
+++ b/ci/real-zfs-guest.sh
@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+# Runs inside the real-ZFS guest, as root, from the directory ci/real-zfs-vm.sh
+# copied the test binaries, this script and ci/real-zfs-weights.txt into.
+# Runs the real-pool tests as concurrent shards, each on its own pool, and
+# leaves their -test.v logs and -test.list output in out/. Pass or fail is
+# decided on the host by ci/check-skips.sh on the merged logs; the exit code
+# here only says whether every shard exited 0.
+#
+# Shards: the endpoint binary split three ways by ci/real-zfs-weights.txt
+# (the file-export tests kept together: one nfsd, one export table), the csi
+# tests other than csi-sanity, csi-sanity on filesystems, csi-sanity on
+# zvols. Six processes on six pools, so no shard's datasets, space
+# accounting or txg syncs meet another's.
+#
+# usage: sudo bash real-zfs-guest.sh
+set -uo pipefail
+out=$PWD/out
+rm -rf "$out"
+mkdir -p "$out"
+up() { cut -d' ' -f1 /proc/uptime; }
+echo "start at uptime $(up)s"
+
+# pools on a tmpfs: real vdevs to the real kmod, without the guest disk,
+# qcow2 and host page cache in every txg sync. Sparse 10G files, as before;
+# the tests write little, and the tmpfs cap makes a runaway write an
+# ENOSPC (pool suspends, test times out) rather than a guest OOM
+vd=/run/zfsci
+mkdir -p "$vd"
+mountpoint -q "$vd" || mount -t tmpfs -o size=60% zfsci "$vd"
+mkpool() { truncate -s 10G "$vd/$1.vdev" && zpool create -f -O compression=lz4 "$1" "$vd/$1.vdev"; }
+
+./endpoint.test -test.list '.*' >"$out/endpoint.list"
+./csi.test -test.list '.*' >"$out/csi.list"
+
+# shard <list> <weights> <n>: "<shard> <test>" per top-level test, fuzz
+# target (its seed corpus) and example, as check-skips counts them; longest
+# first onto the lightest shard
+shard() {
+  awk 'FNR == NR { if ($1 !~ /^#/ && NF == 2) w[$1] = $2; next }
+       /^(Test|Fuzz|Example)/ { g = ($1 ~ /^TestFileExport/) ? "TestFileExport*" : $1
+                 wt[g] += ($1 in w) ? w[$1] : 0.1; m[g] = m[g] " " $1 }
+       END { for (g in wt) printf "%.3f%s\n", wt[g], m[g] }' "$2" "$1" |
+    sort -k1,1gr -k2,2 |
+    awk -v n="$3" '{ b = 0; for (i = 1; i < n; i++) if (load[i] + 0 < load[b] + 0) b = i
+                     load[b] += $1; for (j = 2; j <= NF; j++) print b, $j }'
+}
+ep_shards=3
+shard "$out/endpoint.list" real-zfs-weights.txt "$ep_shards" >"$out/endpoint.plan"
+
+rc=0
+t=(-test.count=1 -test.v -test.timeout=4m)
+pids=() names=()
+# run <name> <pool> <command...>: one shard on its own pool, in the background
+run() {
+  local name=$1 pool=$2
+  shift 2
+  mkpool "$pool" || { echo "zpool create $pool failed" | tee "$out/$name.log"; rc=1; return; }
+  (
+    s=$(up)
+    env ZFS_TEST_POOL="$pool" ZFS_REQUIRE_REAL=1 "$@" >"$out/$name.log" 2>&1
+    r=$?
+    echo "$name rc=$r ${s}s..$(up)s" >>"$out/shards.txt"
+    exit $r
+  ) &
+  pids+=($!) names+=("$name")
+}
+for i in $(seq 0 $((ep_shards - 1))); do
+  re=$(awk -v s="$i" '$1 == s { printf "%s%s", sep, $2; sep = "|" }' "$out/endpoint.plan")
+  [ -n "$re" ] || continue
+  run "endpoint.$i" "zep$i" ./endpoint.test "${t[@]}" -test.run "^($re)\$"
+done
+# csi: the non-sanity tests do not depend on the access type and run once,
+# with mount as before; csi-sanity runs for filesystems and for zvols
+run csi-other zcsi0 env CSI_SANITY_ACCESS_TYPE=mount ./csi.test "${t[@]}" -test.skip '^TestSanity$'
+run csi-mount zcsi1 env CSI_SANITY_ACCESS_TYPE=mount ./csi.test "${t[@]}" -test.run '^TestSanity$'
+run csi-block zcsi2 env CSI_SANITY_ACCESS_TYPE=block ./csi.test "${t[@]}" -test.run '^TestSanity$'
+
+for k in "${!pids[@]}"; do
+  wait "${pids[$k]}" || { echo "${names[$k]} failed"; rc=1; }
+done
+cat "$out/shards.txt"
+# as before: a pool that will not go means a test left something busy
+for p in $(zpool list -H -o name); do
+  case $p in zep[0-9] | zcsi[0-9]) zpool destroy -f "$p" || { echo "zpool destroy $p failed"; rc=1; } ;; esac
+done
+chown -R "${SUDO_UID:-0}:${SUDO_GID:-0}" "$out"
+echo "end at uptime $(up)s, rc $rc"
+exit "$rc"
